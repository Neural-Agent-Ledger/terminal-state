# TERMINAL STATE — levels/L11-inner-circuit.lvl
#
# L11 · "Inner Circuit" — REBUILT to the 2026-09-23 (real-world) owner-approved redesign
# (the spatial redesign §3 L11 + the puzzle-graph redesign
# L11). "NCP-A-04 was never a classifier. It was a lock. We taught it to remember
# who comes in." (K.H.) The net does not resolve to one answer; it must be driven
# through THREE ordered output states — BREAK -> FALL -> DARK — in order.
#
# ── SPACE (NEW) — the rack vault ─────────────────────────────────────────────────
# 24x17x7. You arrive BEHIND the one powered rack of NCP-A-04 (a solid block,
# x=16..18, y=3..13, full height) — a green monolith of its own source code
# standing among dead cabinets in the fog (x=20..22, along y=1 and y=15). Walk
# around either end to the front (west face): the six switches and the three
# lamps on the rack face are in one view, as the ▓█ peak requires. The door is
# behind the switch field, to the WEST.
#
# ── MECHANIC (T6 sequence-lock; re_puzzle SequenceLock / [sequence] section) ──
# Three seq-inputs (s1,s2,s3 = 1) feed a small switchable net whose readout is a
# 3-bit output WINDOW (o1,o2,o3). The lock observes {o1,o2,o3} and demands three
# DISTINCT output states, IN ORDER:
#
#     P1  BREAK : o1 ON , o2 OFF, o3 OFF
#     P2  FALL  : o1 OFF, o2 ON , o3 OFF
#     P3  DARK  : o1 OFF, o2 OFF, o3 ON
#
# Each forward pass, if the CURRENT (not-yet-locked) pattern matches, that step
# LOCKS and progress advances. Locks are MONOTONE. Win when all three are locked.
#
# ── REBUILT GRAPH (the puzzle-graph redesign L11 §1-2) ──────────────
# The SHIPPED graph had a defect: `s2->o3` bypassed `circuit` entirely, so the
# node the level is NAMED AFTER never had to matter (stateless minimum was 1).
# Rebuilt so `circuit` (now T2, needing s1 AND s2) is load-bearing for steps 2
# and 3:
#
#     s1 ─┬─► o1 (T1)                                  <- BREAK bit (pipe A)
#         └─► circuit (T2) ◄─ s2 (pipe C)              <- s1+s2 both required
#     s2 ─┬─► o2 (T2, + circuit)                       <- FALL bit (pipes D, E)
#     s3 ─┬─► o3 (T2, + circuit)                       <- DARK bit (pipes G, F)
#
# Seven switchable pipes, ALL start OFF:
#   A s1->o1   B s1->circuit   C s2->circuit   D s2->o2
#   E circuit->o2   F circuit->o3   G s3->o3
#
# power_budget = 4 (was 2; TRUE minimum, was previously 1 because of the removed
# bypass). Each step's wiring draws the full 4-unit cap, so the STALE WIRES from
# the previous step must be cleared before the next step can be driven — that is
# the attention strain PROGRESSION wants for the peak.
#
# ── THE 3-STEP SOLVE (stateful; drive the lock P1->P2->P3) ──
#   P1 BREAK: ON {A}                          -> o1=1,o2=0,o3=0        locks P1
#   P2 FALL : OFF A; ON {B,C,D,E} (4/4)        -> circuit=2,o2=D+E=2   locks P2
#   P3 DARK : OFF D,E; ON {F,G} (kept B,C)     -> circuit=2,o3=F+G=2   locks P3 = WON
# Stateful minimum: 10 toggles. Stateless (door-target-only) minimum: 4
# ({B,C,F,G}). Decoy pressure: `D` alone or `G` alone never reaches T2 — the
# circuit's s1+s2 feed is never optional.
#
# door_target = o3 (the final pattern's lit bit): re_lvlcheck verifies the FINAL
# output state is reachable (SOLVABLE-by-final-state; the ordered drive is
# covered by re_puzzle unit tests, not by lvlcheck's stateless solver).
#
# ── MOOD: the rack vault — emissive only, no lamps ───────────────────────────────
# decay lives on ONE dead cabinet (a specific casualty, not a wall-wide effect),
# a watcher lattice on the north wall (it has been looking), a thin matrix
# shimmer, and the rack's own cold breath rising off its top. The rack and the
# three lock beacons are the ONLY light in the room — P4's "emissive-only"
# movement identity (the spatial redesign §2).
#
# Verify:
#   cargo run -p re_game --release -- --dump levels/L11-inner-circuit.lvl --ansi
#   (re_lvlcheck::check_level -> COHERENT / SOLVABLE-by-final-state, min=4)

[meta]
name        = level-11-inner-circuit
title       = Inner Circuit
version     = 2
spec_rev    = 2026-09-23
prop_style  = archive

[room]
size        = 24 17 7
ambient     = solid
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05; RAISED 2026-09-23 per
# the puzzle-graph redesign L11). THIS LEVEL: 4 of 7 pipes — the true
# stateless minimum now that the `circuit` bypass is removed. Every step of the
# sequence draws the full cap, so the previous step's wires must be released
# before the next step can be driven.
power_budget = 4
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# ── Surfaces: the rack vault ──────────────────────────────────────────────────
# Cool circuit seams, dimmed — D1 FIX: ambient = solid means this now actually
# paints the perimeter, the rack block and the cabinets (all overridden below by
# [zone]s where they need a distinct look).
[material rack_wall]
fg          = #2A3A40
bg          = #02100F
recipe      = circuit scale=1.7 trace_w=0.11
surface     = wall_solid

# THE RACK'S OWN SOURCE, phosphor green on black, self-lit (codewall ignores
# lamps and light — fitting, since this room has none). Bound via [zone] to the
# rack block's WEST face only (16, y=3..13) — the face the switch field looks at.
# Round-2 dressing: panel 0 showed our own engine's Rust doc comments (critic: "reads
# as an accident"); panel 4 is in-fiction NAL text, so the monolith speaks the lab.
[material rack_code]
recipe      = codewall panel=4
fg          = #45D962
bg          = #03060A

# Dead cabinets — plain void (empty, receded).
[material cabinet_void]
preset      = void

# ONE dead cabinet carries visible bit-rot — a specific casualty among the row,
# not a wall-wide effect.
[material cabinet_decay]
preset      = decay

# The WATCHER wall — a world-fixed eye/face lattice that brightens on approach.
# It has been looking the whole time. Re-kinded onto the north wall via the
# [wall_decal] below (previously authored but never placed — the spatial redesign D1).
[material watch_wall]
preset      = watcher
surface     = wall_trace

# Dark steel floor.
[material cold_floor]
fg          = #4A555F
bg          = #050A0E
recipe      = grain scale=3.2 speck=0.09
surface     = floor

# Near-black ceiling grain (frost DROPPED — the spatial redesign D8).
[material dim_roof]
fg          = #1C222A
bg          = #020304
recipe      = grain scale=3.4 speck=0.07
surface     = ceiling

# The rack's own source, shown on the face the player actually wires against.
[zone rack_face]
region      = (16,3,1)-(16,13,5)
material    = rack_code
scale       = none

# The watcher lattice, across the north wall.
[wall_decal watcher_north]
surface     = trace
region      = (2,0,1)-(21,0,4)

# The dead cabinets — five plain void, one decayed.
[zone cabinet_n1]
region      = (20,1,1)-(20,1,4)
material    = cabinet_void
scale       = none

[zone cabinet_n2]
region      = (21,1,1)-(21,1,4)
material    = cabinet_void
scale       = none

[zone cabinet_n3]
region      = (22,1,1)-(22,1,4)
material    = cabinet_void
scale       = none

[zone cabinet_s1]
region      = (20,15,1)-(20,15,4)
material    = cabinet_void
scale       = none

[zone cabinet_s2_dead]
region      = (21,15,1)-(21,15,4)
material    = cabinet_decay
scale       = none

[zone cabinet_s3]
region      = (22,15,1)-(22,15,4)
material    = cabinet_void
scale       = none

# ── Near-total fog + matrix-rain air ─────────────────────────────────────────
[palette]
fog_color   = #060A10
fog_near    = 2.0
fog_far     = 11.0

[atmosphere]
ambient     = 0.05
postfx      = crt          # P4 THE ARCHIVE movement postfx, owner-approved 2026-09-23 (real-world)

[effects]
matrix      = 0.22
snow        = off

# A slow cold drift rising off the RACK TOP — the room's patient breath.
[emitter rack_chill]
origin_world    = 17.0 8.0 5.0
colors          = 0x2A5A66 0x14323A 0x05131A
color_mode      = RampOverAge
family          = growth_dot
bold            = ByAge
direction       = 0.0 0.0 1.0
spread_deg      = 40.0
size            = 0.9
growth          = 1.1
rate            = 9.0
speed           = 0.4
speed_spread    = 0.15
path_jitter     = 0.06
lifetime        = 3.4
lifetime_spread = 0.5
accel           = 0.0 0.0 0.08
max_particles   = 192
seed            = 711

# ── Dense [cells] grid ────────────────────────────────────────────────────────
# 24 cols (x=0..23) x 17 rows (y=0..16) x 7 z-layers (z=0..6). z=0 floor slab;
# z=1..6 walking / node-pipe / service / upper wall courses. The RACK
# (x=16..18, y=3..13) is solid z=1..5. Dead cabinets (x=20..22, y=1 and y=15)
# are solid z=1..4, shorter than the rack.
#
# Pipe cells at z=2 (and z=3 for pipe B's overhead bridge) are painted as
# WallTrace so the network renders, per the spatial redesign invariant 1 + risk 1.
[cells]
size        = 24 17 7

