# TERMINAL STATE — levels/L1-first-pulse.lvl
#
# L1 · "First Pulse" — SPATIAL REBUILD 2026-09-23 (real-world): a redesigned space
# and puzzle graph. Movement P1 "THE LAB", load ▁,
# onboarding. Identity: a dark stairwell in the sealed lab where a single red lamp is
# the only thing awake, and you climb out of the murk toward first light.
#
# PUZZLE GRAPH: UNCHANGED (the redesign takes B unchanged — the shipped
# graph). One input neuron R (IN=1), one output node `output` (T=1), one pipe
# R→output with a single switch at (5,5,2), door target = output, power_budget = 1.
# The single toggle IS the onboarding idea, not a stub.
#
# WHAT THIS PASS CHANGES (space only, per the redesign brief):
#  - A NEW partition wall at x=10 (y=1..7, z=1..3) seals the ground-floor east bay:
#    the only way onward from the ground floor is UP the stairs, not sideways.
#  - NEW furnished benches on floor 2 (Object blocks, z=5, x=2..6, y=1 and y=7),
#    clear of the stair shaft at y=3.
#  - Two `[light]` lamps (the red pulse-lamp at the switch; a pale first-light lamp
#    over the upstairs alcove) + `[atmosphere]` (ambient pulled to 0.07, cool
#    key_color, `fog_height` so the murk visibly thins as you climb — the climb
#    reads as a literal rise out of the dark) + `postfx = clean` (P1 movement
#    request; the player's own POST-FX setting always wins).
#  - `pulse_wall` fg darkened to #6A2424 so the red the player sees comes from the
#    lamp, not the paint.
# The `[cells]` build, the staircase, all node/pipe/door coordinates, `switch_at`,
# `red_block`, and every note are UNCHANGED — LOCKED by the puzzle-graph doc.
#
# storey_height = 4 (4 ramp treads per storey, matching the prefab generator
# crates/re_level/src/staircase.rs::straight_staircase).
#
# ── Geometry map (z-up; '#'=WallSolid '.'=Empty '_'=Floor '^'=Ceiling) ─────────
#   Map size = 16 × 9 × 13  (x=0..15, y=0..8, z=0..12).
#   z=0      ground-floor slab
#   z=1..3   GROUND-FLOOR gameplay space  (spawn, node R, the pipe switch)
#   z=4      SECOND-FLOOR slab + stairwell shaft + staircase landing
#   z=5..7   SECOND-FLOOR gameplay space  (node output, the exit door)
#   z=8      ceiling slab
#
# Staircase: straight_staircase(base=(3,3,0), dir=PosX, storey_height=4):
#   Tread 1: (4,3,1) rampz posx
#   Tread 2: (5,3,2) rampz posx
#   Tread 3: (6,3,3) rampz posx
#   Tread 4: (7,3,4) rampz posx
#   Landing: (8,3,4) WallSolid Full  (feet on top = z=5.0 = floor-2 surface)
#   z=4 stairwell shaft: (4..6, 3) open '.' so the player body emerges onto floor 2.
#
# Player path: spawn (2,5,1) on the ground floor → flip switch at (5,5,2) →
# north to the y=3 stair corridor → east up the staircase → emerge on floor 2 →
# east along the floor-2 hall to the output node + door at the far +x end.
#
# Dump (spawn view):  cargo run -q -p re_game -- --dump levels/L1-first-pulse.lvl --ansi
# Interactive:        cargo run -p re_game --release -- levels/L1-first-pulse.lvl

[meta]
name        = level-01-first-pulse-tower
title       = First Pulse
version     = 1
spec_rev    = 2026-09-23
prop_style  = lab

[room]
size        = 16 9 13
ambient     = solid
storey_height = 4
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05). At most N pipes may be
# ON at the same time; switching one ON at the cap is REFUSED (the pipe stays off
# and nothing else changes), switching one OFF always frees a unit. Absent or 0 =
# unlimited, which is what every non-campaign level still carries.
# WHY: the forward pass has no inhibition, so activation is MONOTONE in the ON-set
# — without a cap, all-switches-ON wins whenever anything wins, and every decoy in
# the campaign is decorative. This is the number that makes wrong wiring cost.
# THIS LEVEL: 1 of 1 pipe. The tutorial: there is exactly one wire and it must be hot.
# The cap cannot bind here; it exists so the `power 1/1` readout is on screen from
# the very first room and the player learns to read it before it costs them.
power_budget = 1
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# ── LIGHTING ────────────────────────────────────────────────────────────────
# Lamp count = the count of what you are learning (one motif per lamp):
# L1 has 1 lamp (one pulse). A second, paler lamp waits upstairs as "first light".
[light]
pos         = 2.5, 5.5, 3.3
color       = #FF4040
radius      = 3.0
intensity   = 1.3

[light]
pos         = 12.5, 4.5, 7.4
color       = #C8D4F0
radius      = 3.5
intensity   = 0.6

# Ground floor is visibly murkier than the upper floor: `fog_height` thins with
# height, so the climb becomes a literal rise out of the dark.
[atmosphere]
ambient     = 0.07
key_color   = #2A3040
fog_height  = 0.5 0.35
postfx      = clean

# ── COLOR-FORWARD palette (inherits the levels/01.lvl "first light" identity) ──
# Ground floor reads cold and dark — the cold-start void. Walls carry the
# signal-red brick of the first pulse, darkened so the red the player sees comes
# from the `[light]` lamp and not the paint; the floor is cool steel-blue; the
# ceiling the darkest slate so "up" recedes. Saturated colour carries the volume
# so the glyph field stays sparse and legible.
[material pulse_wall]
fg          = #6A2424
bg          = #160505
recipe      = brick aspect=2.0 mortar_w=0.18 grain=0.30
surface     = wall_solid

[material pulse_floor]
fg          = #6FA6CE
bg          = #08111E
recipe      = grain scale=3.0 speck=0.15
surface     = floor

[material pulse_ceiling]
fg          = #3A4658
bg          = #050608
recipe      = sky scale=6.0 density=0.06
surface     = ceiling

[palette]
fog_color   = #100406
fog_near    = 4.0
fog_far     = 20.0

# ── Dense [cells] grid ────────────────────────────────────────────────────────
# 16 cols (x=0..15) × 9 rows (y=0..8) × 13 z-layers.
[cells]
size        = 16 9 13

# z=0 — ground-floor slab. Interior = Floor '_'.
################
#______________#
#______________#
#______________#
#______________#
#______________#
#______________#
#______________#
################

# z=1 — ground-floor space. Ramp tread 1 at (4,3,1).
# NEW partition wall at x=10 (y=1..7): seals the east bay, so the only way on is up.
################
#.........#....#
#.........#....#
#...#.....#....#
#.........#....#
#.........#....#
#.........#....#
#.........#....#
################

# z=2 — ground-floor space. Ramp tread 2 at (5,3,2).
# Node R sits at (2,5,2); the pipe switch the player flips is at (5,5,2).
#
# THE VISIBLE PIPE RUN ('/' = WallTrace), (3,5,2)-(5,5,2)-(5,4,2).
# `[room] render_pipes` stamps the whole R->output path as tagged WallTrace air —
# but `[cells]` is AUTHORITATIVE for geometry and stamps LAST, so on this (the only
# `[cells]`-authored) campaign level every one of those traces was demoted straight
# back to '.' and the pipe stayed invisible. Painting the run here restores it: the
# `[cells]` pass PRESERVES each cell's side_data, so these cells keep the live pipe
# tag `re_level::stamp_pipes` gave them and still drive the flow scroll, the pool
# words and the switch/cycle event pulses.
#
# ONLY the R->switch leg is painted, and only at z=2 — one plane ABOVE the walking
# layer, so the caster's off-slice pass draws it overhead while collision (which
# probes floor(eye_z) = 1 down here) never sees it. The rest of the path is
# deliberately left as air: (5,3,2)/(6..8,3,2..3) run through the STAIRCASE corridor
# where a climbing player's collision probe does reach z=2/z=3, and (13,3,5)/(13,4,5)
# sit in the floor-2 walking layer one step from the exit door — a WallTrace there is
# collidable and would wall the player off from the door.
################
#.........#....#
#.........#....#
#....#....#....#
#..../....#....#
#..///....#....#
#.........#....#
#.........#....#
################

# z=3 — ground-floor space. Ramp tread 3 at (6,3,3).
# NEW partition wall at x=10 (y=1..7), continued from z=1/z=2.
################
#.........#....#
#.........#....#
#.....#...#....#
#.........#....#
#.........#....#
#.........#....#
#.........#....#
################

# z=4 — second-floor slab.
# y=3: stairwell shaft at x=4,5,6 ('.'); tread4 at x=7 ('#'); landing at x=8 ('#').
# All other interior = Floor '_'.
################
#______________#
#______________#
#___...##______#
#______________#
#______________#
#______________#
#______________#
################

# z=5 — second-floor space. The furnished upper hall: node output + door live here.
# Two short interior partition stubs frame the output alcove at the +x end, so the
# floor reads as a built room (an antechamber + an alcove) rather than a bare slab.
#   partition stub A: (10,2,5) and (10,3,5)
#   partition stub B: (10,5,5) and (10,6,5)
# The gap at y=4 is the doorway-width passage from the stair-emergence hall into
# the output alcove (x=11..14).
# NEW furnished benches (Object 'O', z=5, x=2..6) on the north and south walls,
# clear of the stair shaft at y=3 — the redesign's "benches z=5 (NEW)".
################
#..............#
#.........#....#
#.........#....#
#..............#
#.........#....#
#.........#....#
#..............#
################

# z=6 — second-floor space.
################
#..............#
#..............#
#..............#
