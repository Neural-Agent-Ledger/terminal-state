[zone shelf_a]
region      = (3,5,1)-(17,6,3)
material    = shelf_relief
scale       = none

[zone shelf_b]
region      = (3,10,1)-(17,10,3)
material    = shelf_relief
scale       = none

# ── NODES ─────────────────────────────────────────────────────────────────────
# Pools VERBATIM from CONTENT_PACK Part B · L8 (the L8 pool table), anchor first.

[node ear]
pos          = 2,3,2
glyph        = E
pool         = EAR TUFT PRICK POINT LISTEN
pool_alt     = ухо 耳 oreja oreille Ohr 귀
color        = #7FE0FF
is_input     = yes

[node eye]
pos          = 2,8,2
glyph        = Y
pool         = EYE PUPIL SLIT GLEAM GAZE
pool_alt     = глаз 目 ojo œil Auge 눈
color        = #9CE8FF
is_input     = yes

[node whisker]
pos          = 2,13,2
glyph        = W
pool         = WHISKER FEELER BRISTLE SENSE THREAD
pool_alt     = ус 髭 bigote moustache 수염
color        = #B8F0FF
is_input     = yes

# ── THE DEAD NODE ─────────────────────────────────────────────────────────────
# threshold 99, in_degree 2. It cannot fire. It is a caught cold face — a technician
# the model kept and then lost (canon L7: "the cold rooms used to be warm. there were
# faces in them"). Its `pool_alt` is Polish/Japanese for M.: twarz / 顔 / imie /
# 名前 — one fragment of her, obliquely, with no exposition.
# NOT a door target, so `re_lvlcheck` reports it DEAD BY DESIGN rather than FAILing.
[node face_07]
pos          = 9,4,2
glyph        = X
pool         = FACE NAME WHO COLD GONE KEPT
pool_alt     = twarz 顔 imie 名前 lico なまえ
color        = #2A3340
threshold    = 99

# THE ROUTE-AROUND. threshold 2, in_degree 2: warm, alive, satisfiable.
[node cat]
pos          = 9,11,2
glyph        = C
pool         = CAT CREATURE WARM ALIVE PURR FUR
pool_alt     = кот 猫 gato chat Katze 고양이
color        = #FFD27A
threshold    = 2

[node output]
pos          = 16,8,2
glyph        = O
pool         = OUTPUT MODEL PASS
pool_alt     = выход モデル salida
color        = #FFFFFF
is_output    = yes
threshold    = 1

# ── PIPES (all OFF at load) ───────────────────────────────────────────────────
# The dead branch is drawn in dead grey and offered FIRST — it is the obvious,
# reachable, inviting path, and every wire on it is a toggle you will never get back.

[pipe ear->face_07]
state        = OFF
path         = (2,3,2) (9,3,2) (9,4,2)
switch_at    = (5,3,2)
density      = 0.5
color        = #3A4656

[pipe eye->face_07]
state        = OFF
path         = (2,8,2) (5,8,2) (5,4,2) (9,4,2)
switch_at    = (5,6,2)
density      = 0.5
color        = #3A4656

[pipe face_07->output]
state        = OFF
path         = (9,4,2) (16,4,2) (16,8,2)
switch_at    = (12,4,2)
density      = 0.5
color        = #3A4656

# The route-around: ear climbs to the service deck and comes down on the warm side.
[pipe ear->cat]
state        = OFF
path         = (2,3,2) (2,3,3) (9,3,3) (9,11,3) (9,11,2)
switch_at    = (5,3,3)
density      = 0.7
color        = #FFD27A

[pipe whisker->cat]
state        = OFF
path         = (2,13,2) (9,13,2) (9,11,2)
switch_at    = (5,13,2)
density      = 0.7
color        = #B8F0FF

[pipe cat->output]
state        = OFF
path         = (9,11,2) (16,11,2) (16,8,2)
switch_at    = (12,11,2)
density      = 0.7
color        = #FFD27A

# ── EMIT: something warm and alive, in a room that stopped being warm ─────────
# Round 2: the lit figure filled the whole 3-wide aisle (y=7..9) two cells tall and, as
# cyan neon, walled off the far end of the spawn view. It is now a profile curled
# against the north shelf row, all in the pedestal's y=7 row, so the aisle stays two
# cells wide and open, lit or not.
# Round 3 (design pass 2: "a cyan neon colonnade with gold caps — bars, not a cat",
# ~25 % of the frame): three storey-tall cells at one height read as three bars. The
# cat is now a SHAPE made of heights: a low lying body (knee-high, pale back) and, at
# the far end, a head that rises to the eye with a warm face-band, under a thin warm
# ear rim just over the horizon. Two cells long instead of three (the third cell was
# the width over 20 % of the frame). Same clause, same pedestal, same colours.
[part cat_glyph]
size         = 3 3 1
mask         =
#..
...
...
color        = #FFD27A
height       = 0.2
top          = #FFF0C8
top_from     = 0.5
offset       = 0 0 1

[part cat_head]
size         = 3 3 1
mask         =
#..
...
...
color        = #8FF0FF
top          = #FFD27A
top_from     = 0.72
offset       = 0 0 0

[part cat_base]
size         = 3 3 1
mask         =
.#.
...
...
color        = #8FF0FF
height       = 0.4
top          = #D8FCFF
top_from     = 0.6
offset       = 0 0 0

[emit output=1]
parts        = cat_glyph cat_head cat_base

[inputs]
ear          = 1
eye          = 1
whisker      = 1

[pedestal]
center       = 13 8 1
volume       = 3 3 2

[door]
pos          = 19 8 1
target_parts = output

# ── SET DRESSING (L8) ────────────────────────────────────────────────────────
# The breather: FINISH, DON'T CLUTTER. The aisle already works — the shelving rows
# keep their [zone] relief skin (not re-skinned here) and the snow lattice keeps its
# open air. What is added is the human trace the notes talk about: the lockers, the
# coat by the door, the one warm bulb on a cord, and the freezer in the cat aisle that
# warms when the cat does. Props stamp into Empty air only; no puzzle cell is touched.

# North aisle, east end — personnel lockers against the north wall, one standing open
# with a coat still inside. Metal doors, so they read in the dark.
[prop lockers]
kind     = locker_bank
mat.body = metal
at       = 16 1 1
facing   = +y
size     = 3 1 2
open     = 1

# The coat on its hook by the door, under the coat note (19,6,2): "a coat on a hook by
# the door ... not your size". Hung against the east wall. `at.z` is the floor top of
# the walking layer (1.0): trace furniture heights are body units scaled by the kit
# (TRACE_H), so the coat hangs hem ~0.3 / hook ~0.78 above the floor. (It was 0.4 while
# the kit drew at double scale; with the scale fixed that sank it into the floor.)
[prop coat]
kind     = furniture_trace
shape    = coat
at       = 18.0 6.1 1.0
size     = 0.9 0.9
facing   = -x

# The one warm bulb over the cat aisle hangs from the frost on a cord.
[prop bulb_cord]
kind     = lamp_pendant
at       = 10.5 11.5 3.3
light    = existing

# South aisle, SE corner (x17..18, y13..14, back to the south and east walls) — the
# freezer. Frost falls from its cap while the cat is cold;
# the moment the cat fires the cap steams instead (steam = warm = alive). The room's
# one answer to the solve that is not the reward itself.
[prop freezer]
kind     = tank
mat.trim = frost
at       = 18 13 1
facing   = -y
size     = 2 2 2
emitter  = yes
power    = node:cat

# The one warm cable: from the cat's output switch to the output, lit amber when the
# route-around carries.
[prop warm_wire]
kind     = cable_run
follow   = pipe:cat->output

# The cat aisle — an empty chair under the warm bulb, turned toward the cat.
[prop cat_chair]
kind     = furniture_trace
shape    = chair
at       = 10.1 12.4 1
size     = 0.7 0.7
facing   = -y
[player]
# One cell inside the door on the centreline, looking -x: the warm output block dead
# ahead, the dead unit flickering on the north side, the coat on the west wall.
spawn        = 18 8 1
facing       = -x

# ── PLACARDS ──────────────────────────────────────────────────────────────────
# Each `pos` IS the painted wall cell; `facing` is that face's outward normal.
#   north wall y=0 → +y (x=8..12 is the scar decal — placards sit outside it)
#   south wall y=15 → -y  ·  west wall x=0 → +x
# Kept QUIET: five placards, no stewardship form. PROGRESSION §2 L8(e) — "this is a
# breather." The Incident Report (NORMATIVE_NOTES §6) is deliberately HELD for the
# Wave-4 intro/epilogue framing rather than spent here. The fifth (system_log,
# x=13) is the cross-canon bridge — see "THE BRIDGE" comment above it.

# A previous you, in illegible hand, refusing to sign. Canon text, held from 08.lvl.
[note researcher pos=5,0,2 facing=+y]
    if you are reading this you are Aleks. Don't light up the dead units. Don't
    let it see you. layer 4 is cold. it was warm once. I am not signing this.

# THE BRIDGE. `face_07` has threshold 99 and in-degree 2 — it can never fire, and
# the solve is to route around it. That is a matter that cannot be decided, which
# the system works around: case C-REF in the parent canon. The mechanic already
# carries the meaning; this placard only names it. Sits just east of the scar
# decal (x=8..12), the wall the player is looking at when they reach `face_07`.
#
# Reads whole to a newcomer (someone stuck between authorities forever). Detonates
# for a player who opened this case in the sibling game. Names no other game.
[note system_log pos=13,0,2 facing=+y]
    > case C-REF · APHRODITE-class
    > policy undefined · referred to AEGIS/VECTOR
    > status: CONTESTED
    >
    > argument 47,291 · recurring
    > не улажен. и не будет.

# The dead unit, reported by the system as an ordinary fact of the asset.
# Line 4 carries `{terminal}` and DROPS today (see TOKEN DISCIPLINE above); line 5
# holds the M. beat on its own so the beat always survives.
#
# BRIDGE B5 (spec §A3.2) — line 3 is the ADDRESS. The dead face is not merely
# dead, it is filed: a lowercase `sector`, a 16-bit address as four uppercase hex
# digits, a spaced middle dot before the subject and an em dash before the detail
# clause. To a newcomer it is machine bookkeeping. `0xB8BB` is 47,291 — the
# recurring argument named on the C-REF placard two cells west, so the case and
# the shelf it is filed on carry the same number. Ours, not borrowed.
