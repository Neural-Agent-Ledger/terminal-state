# TERMINAL STATE — levels/L8-cold-room.lvl
#
# L8 · "The Cold Room" — the story-true successor to levels/08.lvl (which stays in
# the ARCHIVE folder, golden and untouched).
#
# ── SPATIAL REDESIGN (2026-09-23 (real-world), the spatial redesign §3 L8 +
#    the puzzle-graph redesign §L8) ────────────────────────────────
# The puzzle graph is UNCHANGED (the puzzle-graph redesign §L8: "B unchanged — A differs
# only in node names"): same six nodes, same positions, same pipes, same switches,
# same power_budget, same solution. What changed is the ROOM: two full-height
# shelving rows (aisles) now stand between the three input lanes and the middle
# aisle, with gaps painted exactly where a pipe already crossed the line (invariant
# 1 — never let architecture hide a pipe trace). `ambient` flips trace-pattern ->
# solid (D1 fix) so the authored `shell` wall material actually paints the room
# instead of the room reading as one shared `live_trace` shell; `shell` is
# authored as an explicit `circuit` recipe (not `preset = ice`), so it does not
# become a mirror. A warm bulb lights the cat aisle, a frosted-locker relief skins
# the shelf faces, and the coat note moves from the far west wall to beside the
# door it names (fixing D6 — "on a hook by the door" is now true).
#
# CAMPAIGN SLOT: manifest #8 · movement P3 "The Phantom Sister"
#                load ▄ — **BREATHER** (relief after PEAK 1; warm -> cold)
# NEW IDEA (exactly one): **the dead node** — a unit that is not off, it is
#   permanently unreachable. You do not fix it. You route around it.
#   "The network has scars. I don't fix them; I go around."
#
# ── MECHANIC (plan W2 2.2, PLAN A — data-only, no engine change) ──────────────
#   ear     (IN=1) ─┬─►  face_07 (T=99, DEAD) ──►  output      the obvious path
#   eye     (IN=1) ─┘         ^ can never fire
#   ear     (IN=1) ─┬─►  cat     (T=2)         ──►  output      the route-around
#   whisker (IN=1) ─┘
#
# `face_07` has threshold 99 and in_degree 2: its inputs sum to at most 2, so no
# combination of switches can ever light it. There is NO `dead = true` key in
# `re_level` and none is added — the flag PROGRESSION §6 lists as ✅ does not exist
# (plan R4 already recorded that). The scar is authored as an UNREACHABLE THRESHOLD,
# and the door never needs it: `target_parts = output`, and `output` is reachable
# through `cat` alone. So "route around it" is a real solve, not a hint.
#
# DEAD-BY-DESIGN, MACHINE-CHECKED. `re_lvlcheck`'s `thresholds` rule (added with this
# level) reads: for every non-input node, `0 < threshold <= in_degree`, OR the node
# is DEAD BY DESIGN — `threshold > in_degree` AND the node is not itself a door
# target. `face_07` satisfies the second clause and the rule reports it by name, so a
# reviewer sees the scar declared instead of discovering it. A typo-dead node that
# actually blocked the win would still be caught: it would be a door target (rule
# FAILs) or it would make the level UNSOLVABLE (the `solvable` check FAILs).
#
# BRUTE-FORCE CAP (plan 2.2's required check). 6 switchable pipes ⇒ 2^6 = 64 forward
# passes, far under `re_puzzle::SOLVE_MAX_PIPES` (20 pipes / ~1M passes). The
# unreachable node costs the solver nothing: it is one extra topo node whose
# activation is always 0. lvlcheck reports SOLVABLE with an exact minimum — the
# solver does NOT degrade, so the net does not need shrinking.
#
# SOLUTION (3 toggles): ear->cat, whisker->cat, cat->output — all ON.
#   Every `face_07` pipe stays dark. PROGRESSION §2 L8(c): this is LETHE's kindest
#   level. The dead node is a memory already mercifully gone, and the whole solve
#   honours a forgetting. After L7's loop-dread, forgetting can be peace.
#
# SOLVE PROXIES (plan §6, breathers): min-toggle 3 (cap 4).
# NAME SHARD: none. The name completed at L7; L8 adds nothing and re-reads nothing.
# The dead unit is a letter someone already chose to let go, and you honour the
# absence rather than re-light it.
#
# READOUT (CONTENT_PACK Part B · L8): EAR + EYE + WHISKER -> CAT -> OUTPUT
#   (the clean reading routes ear + whisker; `eye` is offered to the scar and is the
#    unit you can afford to leave unspent.)
# EXIT WORD (CONTENT_PACK Part B · L8): COLD — the dead face you did not light.
#
# ── TOKEN DISCIPLINE (W1 allowlist) ───────────────────────────────────────────
# CONTENT_PACK Part A · L8's atmosphere line uses `{terminal}` (A-7 §3.2.3
# terminal_name). It IS on the W1 allowlist, but it is the one Tier-1 field with NO
# OS read in v0.1 — `OperatorProfile::terminal_name` is `None` in BOTH opt states, so
# `{terminal}` never resolves and the structural-omission rule DROPS its line.
# DECISION: keep the line, knowingly, and put the M. beat on its OWN line so the
# beat always survives. The placard therefore reads one line shorter today and gains
# the terminal line for free the day `re_present` hands the name over
# (`with_terminal_name` is already wired for it). Recorded, not silently dropped.
# No other token appears in this file.
#
# Verify:
#   cargo run -q -p re_game -- --dump levels/L8-cold-room.lvl --ansi
#   cargo run -q -p re_lvlcheck --bin lvlcheck -- levels/L8-cold-room.lvl

[meta]
name        = level-L8-cold-room
title       = The Cold Room
version     = 1
spec_rev    = 2026-07-30
prop_style  = vault

[room]
size        = 20 16 5
floor       = grid
ceiling     = dim
# FIX D1 (2026-09-23 (real-world)): trace-pattern -> solid. With trace-pattern the perimeter
# painted as WallTrace and showed only the shared `live_trace` monitor skin; the
# authored `shell` wall material never reached the screen. `[cells]` below is now
# authoritative for the whole room anyway (the two shelving rows), so `solid` is
# also just the correct base for what `[cells]` paints on top of it.
ambient     = solid
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05). At most N pipes may be
# ON at the same time; switching one ON at the cap is REFUSED (the pipe stays off
# and nothing else changes), switching one OFF always frees a unit. Absent or 0 =
# unlimited, which is what every non-campaign level still carries.
# WHY: the forward pass has no inhibition, so activation is MONOTONE in the ON-set
# — without a cap, all-switches-ON wins whenever anything wins, and every decoy in
# the campaign is decorative. This is the number that makes wrong wiring cost.
# THIS LEVEL: 3 of 6 pipes. ear->cat + whisker->cat + cat->output. face_07 has threshold
# 99 and can NEVER fire; the two wires into it are pure loss. Before the budget the
# dead node was decorative — now feeding the face costs two thirds of the room.
power_budget = 3
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# ── ESCALATION (manifest fog_far = 14.0) ──────────────────────────────────────
# `snow = 0.35` — the COLD axis at its widest so far (STORY_BIBLE §7: snow = cold,
# distance, forgetting — L3 / L6 / L8), and NO steam: the warm chamber of L7 has
# gone cold, which is the level's whole temperature arc. The matrix bleed EASES back
# from L7's 0.40 to 0.30 and `glitch` from 0.30 to 0.25 — the one place in the ramp
# that relaxes, because this is the breather and the room is meant to feel like
# relief. fog_far holds at L7's 14.0: no further closing during a breath.
[effects]
snow        = 0.35
matrix      = 0.30
glitch      = 0.25

[palette]
fog_color   = #070B12
fog_near    = 2.0
fog_far     = 14.0

# ── LIGHTING (spatial redesign 2026-09-23 (real-world)) ───────────────────────
# One warm bulb over the cat aisle — the level's whole "one warm place in the
# cold" landmark (§3 L8 Landmark). Ambient pulled down from the 0.18 default so
# the pool actually reads as a pool against the frost.
# pos.x nudged off 9.5 -> 10.5: the exact (9,11) column carries the ear->cat
# pipe's z=3 vertical drop as a WallTrace cell, and lvlcheck's `lighting` check
# correctly flags a lamp buried in wall geometry as bleeding through it instead
# of lighting the room. One cell east is open air and still reads as "over the
# cat aisle".
[light]
pos         = 10.5, 11.5, 3.3
color       = #FFD27A
radius      = 3.0
intensity   = 1.1

[atmosphere]
ambient     = 0.10
key_color   = #607890
postfx      = subtle    # P3 "The Basement & The River" — owner-approved 2026-09-23 (real-world) per-movement postfx

# ── COLOR-FORWARD palette ─────────────────────────────────────────────────────
# A refrigerated storage layer: cold cyan ink on deep blue-black, a slightly warmer
# steel deck so the ground reads distinct, frost overhead pressing down.
#
# FIX D1 (invariant 7): this was `preset = ice`, which is reflective — every
# `ice` wall becomes a mirror under `mirror_ramp`. No mirror is authored for L8,
# so the pattern is spelled out directly (`recipe = circuit`, same look) with
# `reflective = false` on top, instead of the preset.
[material shell]
recipe      = circuit scale=1.6 trace_w=0.12
fg          = #5FC8E0
bg          = #060C16
surface     = wall_solid
reflective  = false

[material deck]
preset      = metal
fg          = #6E7C8C
bg          = #0A1018
surface     = floor

[material frost_roof]
preset      = frost
fg          = #7FA0B4
bg          = #050A10
surface     = ceiling

[material live_trace]
preset      = monitor
fg          = #8FF0FF
bg          = #07121C
surface     = wall_trace

# THE SCAR. The wall behind `face_07`, skinned with the shipped `decay` semantic
# material and set to FLICKER — the dark, intermittent signal of a unit that is
# still wired in and receiving nothing. `flicker` is STORY_BIBLE §7's "signal lost".
# This is what makes visually-dead read as DEAD and not merely as OFF.
[material dead_scar]
preset      = decay
fg          = #2A3340
bg          = #03060A
animation   = flicker speed=0.8 amplitude=0.45
surface     = wall_matrix

[wall_decal]
surface     = matrix
region      = (8,0,1)-(12,0,3)

# THE SHELF FACES. Frosted locker doors — the same generated relief plate as
# `22-lit-cellar.lvl` (colour AND height map, so the bulb rakes across rivets and
# seams instead of lighting a flat decal). Joins the colour palette (no `surface =`)
# so the `[zone]`s below can stamp it onto the shelf's own WallSolid cells.
[texture shelf_plate]
file        = assets/texture/genplate_tex.png
height      = assets/texture/genplate_tex.png

[material shelf_relief]
recipe      = image
texture     = shelf_plate
tile        = 3 1
relief      = height_scale=1.1 normal_strength=0.8

# ── COLD VENT (optional, redesign §3 L8 "breath slowed near to stillness") ────
# A slow, sparse cold haze over the north aisle. accel matches the spec's own
# "haze settling" default (0 0 -0.02) — this is barely a stream, not a storm.
[emitter cold_vent]
origin_world    = 9.0 1.5 3.6
colors          = 0x8FA0B0 0x5A7080 0x2A3A46
color_mode      = RampOverAge
family          = haze_dot
bold            = Off
direction       = 0.0 0.0 -1.0
spread_deg      = 50.0
rate            = 6.0
speed           = 0.15
speed_spread    = 0.05
path_jitter     = 0.15
lifetime        = 4.5
lifetime_spread = 0.6
accel           = 0.0 0.0 -0.02
max_particles   = 128
seed            = 3007
blend           = KeepBg

# ── [cells] — the two shelving rows ───────────────────────────────────────────
# Full-height (z=1..3) WallSolid blocks. Gaps sit EXACTLY where a pipe already
# crosses the line (invariant 1): row A (y=5..6) gaps at x=5 (eye->face_07),
# x=9 (ear->cat's z=3 detour) and x=16 (face_07->output / cat->output); row B
# (y=10) gaps at x=9 and x=16. Every pipe cell this grid touches is repainted
# `/` (WallTrace) so `render_pipes`'s side_data (flow scroll, pool words, the
# switch/cycle pulse) survives `[cells]` being authoritative — the node's own
# cell is left plain, matching `L1-first-pulse.lvl`'s convention.
[cells]
size        = 20 16 5

# z=0 -- floor slab.
####################
#__________________#
#__________________#
#__________________#
#__________________#
#__________________#
#__________________#
#__________________#
#__________________#
