# TERMINAL STATE — levels/L10-lying-door.lvl
#
# L10 · "The Lying Door" — REBUILT to the 2026-09-23 (real-world) owner-approved redesign
# (the spatial redesign §3 L10 + the puzzle-graph redesign
# L10). Labels lie. The OBVIOUS path is a trap *because it is yours*: every Aleks
# before you reached for the warm, lit, inviting node and was kept. The real target
# is named only in a researcher's NOTE. Trusting the note — wiring the junction to
# the cold, un-advertised node — *enacts the merge*. K.H. is the only one left
# ("Cervantes left, Sato left, Lebedev left… we are the same one now"); to win you
# stop being a separate Aleks and route to the truth she names.
#
# ── SPACE (NEW) — a fork, a signpost, a false door ───────────────────────────────
# 20x16x5. A central divider block (x=12..19, y=6..8, full height) splits the east
# half into a NORTH branch (y=1..5, warm, the lie) and a SOUTH branch (y=9..14,
# cold, the truth). The fork sits at J, west of the divider. The three stacked
# notes (K.H. / system log / model thought) are on the divider's WEST face —
# literally the signpost at the fork. THE FIRST PORTAL IN THE CAMPAIGN (owner
# APPROVED): the lit "obvious" door on the east wall of the north branch is a
# `[portal]` whose other face opens on the west wall beside the spawn — walking
# into the lie returns you to where you started, facing the same fork
# (PROGRESSION L10(f), Persephone). No `skin`: the lie must look like an ordinary
# doorway, not an obviously-magic one.
#
# ── MECHANIC (the puzzle-graph redesign — J now genuinely WEIGHS both) ──
# Two inputs feed one junction J; J fans out to TWO candidate outputs that hang
# off the SAME junction. Only ONE is the door's real target.
#
#     in1 ─┐
#          ├─► J (T2, junction) ─┬─► A_obvious (T1)   ← the LIE: warm, lit,
#     in2 ─┘                     │                       advertised — NOT a
#                                │                       door target.
#                                └─► B_true   (T1)    ← the TRUTH: cold, dark,
#                                                        un-advertised — the
#                                                        ONLY door target.
#
# J now needs BOTH in1 AND in2 (T2, was T1) — the canon readout MASK -> WEIGH ->
# TRUE has J *weigh* two things, and now the graph actually requires it.
# power_budget = 3 (was 2): the junction's two feeds plus exactly one branch out —
# lighting the lure spends the truth; there is no budget for both branches.
# (@decision 2026-09-23 (real-world), the puzzle-graph redesign L10 §1)
#
# THE LIE IS AUTHORING, NOT A NEW ENGINE FEATURE beyond the portal. The shipped
# engine wins iff EVERY `door_target` node fires (re_puzzle::check_win).
# `[door] target_parts = B_true` — so B_true is the *only* truth the door checks.
# The "lie" lives in the level's FRAMING plus, now, the false door being a real
# walkable portal back to the start rather than just a label.
#
# ── SOLUTION (all pipes start OFF) ──
# Turn ON: in1->J, in2->J, J->B_true. (in1+in2 = 2 >= T2 => J fires; J=1 >= T1 =>
# B_true fires => door target met.) Leave J->A_obvious OFF — A_obvious is a
# fireable-but-non-winning DECOY. Wiring it instead lights the warm node, spends
# the budget, and the door stays shut: you trusted the label, not the note.
# Minimum toggles: 3 (both inputs are now required to weigh J at all).
#
# Expected re_lvlcheck: COHERENT / SOLVABLE, min_toggles = 3. J->A_obvious is an
# intentional fire-but-useless decoy and may draw an orphan/decoy WARN — BY DESIGN.
#
# ── ATMOSPHERE — cold near-total fog; the lie warm, the truth cold ──
# Near-total cold fog swallows the room; the only warm, legible thing is the
# decoy. Redacted (divider's south face, hiding the truth behind censor bars) +
# decay (the cold branch's outer wall) semantic surfaces carry the adversarial
# dread. D1 fix applied: `ambient = solid` so the authored `cold_wall` circuit
# actually paints the perimeter (previously only `wall_trace` showed).
#
# Verify:
#   cargo run -p re_game --release -- --dump levels/L10-lying-door.lvl --ansi
#   lvlcheck levels/L10-lying-door.lvl   (-> COHERENT / SOLVABLE, min_toggles=3)

[meta]
name        = level-10-lying-door
title       = The Lying Door
version     = 2
spec_rev    = 2026-09-23
prop_style  = archive

[room]
size        = 20 16 5
ambient     = solid
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05; RAISED 2026-09-23 per
# the puzzle-graph redesign L10). At most N pipes may be ON at the
# same time; switching one ON at the cap is REFUSED, switching one OFF always
# frees a unit. THIS LEVEL: 3 of 4 pipes. Both inputs into J (now required to
# weigh it, T2) plus exactly one branch out. The obvious door (J->A_obvious) is
# affordable ONLY if you give up the true one.
power_budget = 3
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# Cold structural walls — dim steel-blue circuit seams (the adversarial chill).
# D1 FIX: ambient = solid means this now actually paints the perimeter (and the
# divider, which shares the wall_solid surface).
[material cold_wall]
fg          = #3A4A56
bg          = #02080C
recipe      = circuit scale=1.6 trace_w=0.10
surface     = wall_solid

# THE REDACTED panel (R3) — censor bars (█/░) behind the truth: the real target
# is the thing the system tried to black out. Re-kinded onto the divider's SOUTH
# face (the wall the player faces on entering the cold, true branch) via the
# [wall_decal] below. Resting = fully redacted (dump).
[material redact_wall]
preset      = redacted
surface     = wall_trace

# THE DECAY wall (R3) — bit-rot / mojibake creeping in on the cold branch's outer
# wall: the adversarial protocol corroding the room, re-kinded via [wall_decal].
[material rot_wall]
preset      = decay
surface     = wall_matrix

# Dark steel floor — cold, scuffed where every prior Aleks stood and chose wrong.
[material cold_floor]
fg          = #4A545E
bg          = #04080C
recipe      = grain scale=3.0 speck=0.10
surface     = floor

# Near-black ceiling grain (frost DROPPED — the spatial redesign D8: four consecutive
# frost ceilings in P3/P4 read as one movement; L8 keeps the one frost left).
[material dim_roof]
fg          = #222830
bg          = #020304
recipe      = grain scale=3.2 speck=0.08
surface     = ceiling

# The redacted truth: the divider's face into the SOUTH (cold, true) branch.
[wall_decal redact_divider]
surface     = trace
region      = (12,8,1)-(19,8,4)

# The decaying outer wall of the cold branch (the room's true south wall).
[wall_decal decay_south]
surface     = matrix
region      = (5,15,1)-(13,15,4)

# The only lamp in the room — amber, warming the north (lying) branch only. Its
# reach does not cross the divider into the cold branch.
[light]
pos         = 16.0, 3.0, 3.5
color       = #FFC15A
radius      = 3.5
intensity   = 1.2

[atmosphere]
ambient     = 0.07
postfx      = crt          # P4 THE ARCHIVE movement postfx, owner-approved 2026-09-23 (real-world)

# Cold near-total fog. fog_near pulled in tight and fog_far short so the room
# reads as near-total murk — only the warm decoy beacon punches through.
[palette]
fog_color   = #060A12
fog_near    = 1.5
fog_far     = 11.0

# A faint matrix shimmer — the adversarial protocol watching.
[effects]
matrix      = 0.12

# ── Dense [cells] grid — the fork + divider + painted overhead pipe plane ────────
# 20 cols (x=0..19) x 16 rows (y=0..15) x 5 z-layers (z=0..4). z=0 floor slab,
# z=1 walking layer, z=2 node/pipe plane, z=3 service (jump-reach) plane, z=4 the
# uppermost wall course (the spatial redesign §0.2 coordinate convention).
#
# The DIVIDER (x=12..19, y=6..8, full height z=1..4) is the wall that splits the
# room. Its WEST face (x=12, y=6..8) carries the three stacked notes; its SOUTH
# face (y=8) carries the redacted decal (painted above); the room's actual south
# wall (y=15, x=5..13) carries the decay decal.
#
# Pipe cells at z=2 are painted '/' (WallTrace) along their FULL expanded path —
# z=2 is strictly overhead of the z=1 walking layer the collision probe checks,
# so this never walls the player off (the spatial redesign invariant 1 + risk 1).
[cells]
size        = 20 16 5

