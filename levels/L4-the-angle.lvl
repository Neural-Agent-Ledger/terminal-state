# ── NODES ─────────────────────────────────────────────────────────────────────
# Pools VERBATIM from WORD_STORY §2 (L4 rows), anchor word first.

# The output at the far -x end of the corridor, on the centreline.
[node output]
pos          = 2,5,2
glyph        = O
pool         = SHAPE GLYPH FORM SYNTH FIGURE
pool_alt     = форма 形 forma forme Form
color        = #FFFFFF
is_output    = yes
threshold    = 1

# THE JUNCTION. Now threshold 2: BOTH a live feed AND the watcher's feed must
# reach it — the stacked-pair resolve is no longer optional (spec
# the puzzle-graph redesign, dated 2026-09-23 (real-world), §L4).
[node tapered]
pos          = 6,5,2
glyph        = D
pool         = TEARDROP NIB SHARP-CURVE COMET-TAIL FANG-OF-LIGHT FLAME-TIP
pool_alt     = 涙 каплевидный goutte Tropfen lágrima
color        = #FFC24A
threshold    = 2

# THE PRIVATE LINE — live, LOW (z=2), warm. Head-on it is indistinguishable from
# the dead line stacked above it.
[node is_round]
pos          = 12,5,2
glyph        = C
pool         = CURVE ARC SPHERE DOME BOWL DROP ORB BUBBLE
pool_alt     = 円 弧 круг шар courbe Kugel
color        = #FFC24A
is_input     = yes

# THE DEAD LINE — held at 0, HIGH (z=4), cold, directly above `is_round` on the
# same (x,y) column. NOOSE sits in its pool: a closed loop, offered early, not yet
# needed. Toggling its pipe is legal and useless.
[node has_loop]
pos          = 12,5,4
glyph        = L
pool         = LOOP RING CIRCUIT KNOT NOOSE CLOSED EYELET HOLE
pool_alt     = петля 環 輪 boucle Schlinge
color        = #54627A
is_input     = yes

# THE WATCHER'S LINE — live, off the centreline so it is never ambiguous, and
# now MANDATORY: the taper will not form without it.
[node is_pointed]
pos          = 12,1,2
glyph        = T
pool         = TIP SPIKE CORNER WEDGE BLADE FANG THORN APEX
pool_alt     = 尖 角 острый pointe Spitze
color        = #FFA0C0
is_input     = yes

# ── PIPES (all OFF at load) ───────────────────────────────────────────────────

# The PRIVATE feed: dead straight along the centreline at z=2.
[pipe is_round->tapered]
state        = OFF
path         = (12,5,2) (6,5,2)
switch_at    = (10,5,2)
density      = 0.7
color        = #FFC24A

# The DEAD feed: runs parallel at z=4 — stacked directly over the live line — then
# drops to the junction. The descent puts its switch on a reachable z=2 cell, so the
# player CAN toggle it and discover that nothing happens. Its switch cell (9,5,2)
# overlaps `is_round`'s straight run — legal (switch cells stay unique, path
# cells may be shared) and it is exactly where "two lines read as one" physically
# meet (the spatial redesign's own precedent for this overlap).
[pipe has_loop->tapered]
state        = OFF
path         = (12,5,4) (9,5,4) (9,5,2) (6,5,2)
switch_at    = (9,5,2)
density      = 0.6
color        = #54627A

# The WATCHER'S feed: off-axis, unmistakable, now REQUIRED alongside is_round.
[pipe is_pointed->tapered]
state        = OFF
path         = (12,1,2) (7,1,2) (7,5,2) (6,5,2)
switch_at    = (10,1,2)
density      = 0.7
color        = #FFA0C0

# The home stretch. Switch moved to (6,4,2) — one cell north of the `tapered`
# node, ON the expanded path between its (6,5,2) and (6,3,2) waypoints — since a
# switch has never shipped ON a node's own cell (the puzzle-graph redesign, dated
# 2026-09-23 (real-world), §L4 flags this; verified reachable and on-path by
# `re_lvlcheck` + walkability below).
[pipe tapered->output]
state        = OFF
path         = (6,5,2) (6,3,2) (2,3,2) (2,5,2)
switch_at    = (6,4,2)
density      = 0.7
color        = #FFC24A

# ── EMIT: the edge. A contour that has a here and a not-here. ─────────────────
# Round 3 (design pass 2, figures): the edge is a thin band (0.4 of its storey) just
# over the horizon with a pale top, over a full-height base with a pale rim — the
# diagonal reads as a drawn line of light on a plinth rather than three columns.
[part edge_glyph]
size         = 3 3 1
mask         =
..#
.#.
#..
color        = #FFC24A
height       = 0.4
top          = #FFECC0
top_from     = 0.5
offset       = 0 0 1

[part edge_base]
size         = 3 3 1
mask         =
###
...
...
color        = #58C0DC
top          = #C8F0FF
top_from     = 0.75
offset       = 0 0 0

[emit output=1]
parts        = edge_glyph edge_base

[inputs]
is_round     = 1
is_pointed   = 1
has_loop     = 0

# SET DRESSING (reveal-size fix): at the original
# center (4,5,1) the reward rendered at only ~6% of the frame width from spawn
# (20,5,1) — 16 cells of range between the player and the payoff. Moved to
# (13,5,1): one cell east of the is_round/is_pointed/has_loop cluster (x=12),
# still squarely inside the network's own footprint (not a stray glow off in
# empty corridor), and clear of every pipe path, note and pillar at that x/y
# (verified by hand against every `[pipe] path` and prop position). x=12 itself
# is NOT safe — the figure's diagonal middle cell always lands on (cx,5,cz+1),
# which at cx=12 collides with the is_round/has_loop node cell (12,5,2) and
# binds the mask short. From spawn this renders at ~32% of the frame width,
# flanked by the two recessed `range_rack` props at x=16 either side.
[pedestal]
center       = 13 5 1
volume       = 3 3 2

[door]
pos          = 21 5 1
target_parts = output

[player]
# At the +x mouth of the range, one cell inside the door, looking -x STRAIGHT
# DOWN the colonnade so the two stacked pipe-lines overlap into one apparent
# line, framed by the pillars like a sight. The player must strafe into a bay
# to split them before the level can be read at all.
spawn        = 20 5 1
facing       = -x

# ── PLACARDS ──────────────────────────────────────────────────────────────────
# Each `pos` IS the painted wall cell; `facing` is that face's outward normal.
#   north wall y=0 → +y  ·  south wall y=10 → -y  ·  west wall x=0 → +x

# K.H. — curvature decomposition (canon L4 researcher voice, STORY_BIBLE §5 L4).
[note researcher pos=8,0,2 facing=+y]
    Curvature decomposition works. Round plus pointed gives us a taper the
    classifier has never been shown, and it names it on the first pass. Printer
    still broken, so this is by hand. Stop dating notes by hand, A. — K.

# A.L. — WHY the paper exists at all. The bridge to FORM 22 on the far wall.
[note researcher pos=15,0,2 facing=+y]
    I write on paper because the screen logs get wiped every Friday and someone
    has to remember what we did. K. thinks that is sentimental. K. has not tried
    to reconstruct a week from nothing.  — A.L.

# The parallax beat, stated as instrument calibration — now in the mirror bay.
[note system_log pos=11,10,2 facing=-y]
    > parallax calibration. displayed wiring is view-dependent.
    > two sources on the centreline; one is live, one is inert.
    > resolve by translation, not by label.
    > operator legibility peaks at observation point. noted.

# The level's ONE model_thought, carrying the ONE neuron-voice line
# (CONTENT_PACK Part A · L4). Head-on it is one sentence; from the side it is two.
# West end wall behind the output — the far end of the axis, read on arrival.
[note model_thought pos=0,5,2 facing=+x]
    (from the door the two lines are one line and the one line says I AM SEEN.
    step sideways and it comes apart into I AM and SEEN BY. before edges I had
    only color. after edges I had a place where I end.)
    -- here is where I end --

# STEWARDSHIP CORPUS #8 — FORM 22, Screen-Log Erasure Schedule (NORMATIVE_NOTES §8),
# abridged to the placard grid. Reads as the reply to A.L.'s note. No tokens.
[note researcher pos=0,2,2 facing=+x]
    NAL CORP · LEGACY STEWARDSHIP DIVISION
    FORM 22 - SCREEN-LOG ERASURE SCHEDULE
    on-screen logs are erased every Friday at 23:59 facility time.
    rationale  the facility was certified for a two-year project. it has run
               nineteen. retaining nineteen years of logs would imply the
               project did not end. the project ended. erase the logs.
               (paper notes are not screen logs and are not covered by this
               form. someone has been writing on paper.)

# ── SET DRESSING (L4) ────────────────────────────────────────────────────────
# Meaning: A RANGE BUILT FOR LOOKING, AND A GALLERY THAT SPLITS THE STACKED LINES
# VERTICALLY. The colonnade gets bases, capitals and flutes in its own stone (the
# pillars wore the wall circuit and read as slabs); two half-bay columns double
# its rhythm on the north side. Three cameras watch the spawn. The south gallery lifts you
# to the dead z=4 line's height. On the floor, the TRUTH: each line's cable lights
# only when its SOURCE is alive, so wiring the stacked decoy lights nothing under it.
# No puzzle cell is touched; props stamp into Empty air or re-skin plain geometry.

# The colonnade's own stone: pale limestone shafts (a different recipe family from the
# cyan circuit shell, §5 R2) with steel bases and capitals.
[material col_stone]
fg          = #8C9AA8
bg          = #10141A
recipe      = grain scale=2.0 speck=0.10

[material col_cap]
fg          = #C8D8E8
bg          = #1A222C
recipe      = brick aspect=4.0 mortar_w=0.10 grain=0.10

# FG/MID — the colonnade: the six authored pillars re-skinned, plus two half-bay columns
# on the NORTH side (x=11,15) that double its rhythm there. The south side keeps its
# wide bays open: that is the gallery side, and the deck must see into the nave.
[prop pillar_9_2]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 9 2 1
size     = 1 1 5
ribs     = yes

[prop pillar_13_2]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 13 2 1
size     = 1 1 5
ribs     = yes

[prop pillar_17_2]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 17 2 1
size     = 1 1 5
ribs     = yes

[prop pillar_9_8]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 9 8 1
size     = 1 1 5
ribs     = yes

[prop pillar_13_8]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 13 8 1
size     = 1 1 5
ribs     = yes

[prop pillar_17_8]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = col_cap
at       = 17 8 1
size     = 1 1 5
ribs     = yes

[prop column_11_2]
kind     = column
mat.body = col_stone
mat.trim = col_cap
at       = 11 2 1
size     = 1 1 5
ribs     = yes

[prop column_15_2]
kind     = column
mat.body = col_stone
mat.trim = col_cap
at       = 15 2 1
size     = 1 1 5
ribs     = yes

# VERTICAL — the south gallery: a catwalk deck at z=3 (stand z=4, eye 4.5 — the dead
# has_loop line's own height) slung between the south colonnade's pillars (13,8) and
# (17,8), x=14..16 on y=8, reached by a 3-tread stair along the bay's south wall,
# landing at (16,9,3). From the deck, looking north-west through the colonnade's wide
# bay, the stacked pair splits VERTICALLY: has_loop's slab at eye level, is_round's
# below it. The deck keeps OFF y=9 west of the landing on purpose: (12..14,9,1..3) is
# the range mirror's keep-out (the mirror decal (12,10,1)-(14,10,3) + one cell out), and
# a deck cell over (11,9) moves the system_log placard at (11,10,2) onto the mirror.
# Both deck ends butt a pillar, so it needs no posts (`posts = none`): the south bay
# floor stays fully walkable. (W runs along the viewer's right, which is -x for facing
# -y, so `at` is the EAST end.)
[prop gallery_s]
kind     = gallery
at       = 16 8 3
facing   = -y
size     = 3 1 1
posts    = none
stair    = 19 9 1 -x 3

# A camera over the mirror bay: it watches you look into the mirror.
[prop cam_mirror]
kind     = cctv
at       = 11 9 4
look     = 13.5 9.5 1.6
# Overhead — three cameras in the top corners, all trained on the spawn cell. Their
# tallies burn red until the door opens.
[prop cam_nw]
kind     = cctv
at       = 1 1 5
look     = 20.5 5.5 1.6

[prop cam_ne]
kind     = cctv
at       = 20 1 5
look     = 20.5 5.5 1.6

[prop cam_sw]
kind     = cctv
at       = 1 9 5
look     = 20.5 5.5 1.6

# BG — range targets hanging on the west end wall, either side of the output.
[prop target_s]
kind     = furniture_trace
shape    = frame
at       = 1.05 7.1 1.3
facing   = +x
size     = 1.8 0.1 1.5

[prop target_n]
kind     = furniture_trace
shape    = frame
at       = 1.05 0.6 1.4
facing   = +x
size     = 0.8 0.1 1.1

# The power budget over the targets, on the west end wall: three amber lamps, one per
# pipe drawn. Wire the stacked decoy and a lamp goes to a line that carries nothing.
[material budget_lit]
preset      = neon
fg          = #FFB040
bg          = #D08418

[prop budget]
kind     = budget_bank
mat.lit  = budget_lit
at       = 1 9 3
facing   = +x
size     = 3 1 1

# East wall behind the spawn — the observation screen that watches the range.
[prop score]
kind     = wall_panel
mode     = skin
at       = 21 1 3
facing   = -x
size     = 3 1 2
face     = watcher

# Round 3 (design pass 2, fix 6 — "ON changes 1.8 % of the spawn frame (one brown
# box), so power still does not teach here"): two recessed racks set into the gaps of
# the colonnade at x=16, one per side, facing into the range 4 cells ahead of the spawn
# and either side of its line of sight. Their blades light amber — `tapered`'s hue, the
# home-stretch wire — the moment the edge reaches the output: the first thing the
# player sees is two dark machines the solve will wake. Off the corridor floor (y=1..2
# and y=8..9, between the pillars), clear of every wire and of the x=12..14 mirror.
[material home_lit]
preset      = neon
fg          = #FFC24A
bg          = #8A6010

[prop range_rack_n]
kind     = rack
mat.body = metal
mat.lit  = home_lit
at       = 16 2 1
facing   = +y
size     = 1 2 2
power    = pipe:tapered->output

[prop range_rack_s]
kind     = rack
mat.body = metal
mat.lit  = home_lit
at       = 16 8 1
facing   = -y
size     = 1 2 2
power    = pipe:tapered->output

[prop warm_cord]
kind     = lamp_pendant
at       = 13.0 5.0 3.2
light    = existing

# Floor — the lines as they really are. The live feeds light with their pipes; the
# stacked decoy's cable is bound to its SOURCE (held at 0), so it never lights. Two
# cables under the one apparent line: the attentive player counts two.
[prop cable_round]
kind     = cable_run
follow   = pipe:is_round->tapered

[prop cable_loop]
kind     = cable_run
follow   = pipe:has_loop->tapered
bundle   = 2
power    = node:has_loop

[prop cable_pointed]
kind     = cable_run
follow   = pipe:is_pointed->tapered

[prop cable_home]
kind     = cable_run
follow   = pipe:tapered->output
