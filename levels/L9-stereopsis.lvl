# TERMINAL STATE — levels/L9-stereopsis.lvl
#
# L9 · "Stereopsis" — two records of one self. Where L8 was about LETTING a cold
# unit stay dark, L9 is the reversal: the solve REQUIRES holding BOTH records at
# once. The answer is the state that is true from both sides simultaneously.
#
# ── SPATIAL REDESIGN (2026-09-23 (real-world), the spatial redesign §3 L9 +
#    the puzzle-graph redesign §L9) ────────────────────────────────
# The flat 20x14x5 box becomes a 22x15x6 room split by a real SPINE WALL
# (`[cells]`, `/` = WallTrace, x=1..10 along y=7) into a LEFT hall (y=1..6) and a
# RIGHT hall (y=8..13); east of x=11 the halls merge into the conjunction court
# where `both` and the door sit. The spine carries the `facet` (ByAngle)
# material end-on, so its angle-glyph turns as you walk the court. Each hall
# ends in a MIRROR — the west wall (x=0), clarity 0.6 authored (the campaign's
# `mirror_ramp` overrides live clarity) — that reflects the hall back with no
# one in it. Palette moves to bone-and-silver (breaking the L8-L11 cyan run,
# the spatial redesign §1 D8); `watch_wall` (watcher) is DROPPED because its
# `wall_matrix` slot is now spent on the mirrors — L11 and L12 still carry the
# watcher. The ceiling drops `frost` for plain dark grain (also D8).
#
# THE PUZZLE GRAPH CHANGES (the puzzle-graph redesign §L9, overrides the brief where
# they conflict): two `IN=0` "echo" inputs are added, one beside each end
# mirror — `echo_l` (in the LEFT hall) carries the RIGHT hall's words, `echo_r`
# (in the RIGHT hall) carries the LEFT hall's — a reflection that looks like a
# source. Each wires into its OWN hall's hidden node. With power_budget 6 and
# now 8 switchable pipes, "flip everything" no longer wins (the spatial redesign §5:
# the old defect was a level rated ▆ that was mechanically lighter than L8
# because every wire was load-bearing and there was nothing else to touch) —
# spending an echo is a real half gone dark. New pipes 6-7 are appended LAST so
# the bit order of pipes 0-5 is preserved for existing tests. Cross-hall wires
# were considered and rejected: any cross-wire from a LIVE input creates a
# second winning set, which would be a decoy that also wins.
#
# ── MECHANIC (NO new runtime feature — pure threshold graph + ByAngle skin) ──
# A conjunction. Two independent sub-nets each gate a hidden node; the output
# fires ONLY when BOTH hidden nodes are lit:
#
#     w ─┐                         (left record)
#        ├─► h_left  (T2) ─┐
#     x ─┘                 │
#                          ├─► both (OUT, T2)  ← door target; needs BOTH hiddens
#     y ─┐                 │
#        ├─► h_right (T2) ─┘
#     z ─┘                         (right record)
#
#   * h_left  fires when w + x ≥ 2  (both left inputs)
#   * h_right fires when y + z ≥ 2  (both right inputs)
#   * both    fires when h_left + h_right ≥ 2  (BOTH hidden representations)
#
# `both` is a standard threshold-2 output fed by two threshold-2 hiddens — the
# shipped engine evaluates this directly. The win rule (re_puzzle: every
# door_target must fire) makes `both` an AND of the two sub-nets. The
# "stereopsis / bistable" is the VISUAL framing, not a graph feature.
#
# THE ECHOES (2026-09-23 (real-world)). `echo_l` (IN=0) stands beside the left mirror and
# wires into `h_left`; `echo_r` (IN=0) stands beside the right mirror and wires
# into `h_right`. Neither ever fires (E2: an IN=0 input never fires) and neither
# ever enters the readout (E9) — but if a player turns one ON anyway, it draws a
# unit from the budget that the real solve needs, and turns its own half dark
# below T2. A reflection that looks like a source costs you the record it stands
# beside.
#
# Win toggle (all pipes start OFF): turn ON
#   w->h_left, x->h_left, y->h_right, z->h_right, h_left->both, h_right->both
# Drop any one and `both` falls below T2 → door stays shut. You cannot pick one
# side; you must hold both at once (the L3 reversal). `echo_l->h_left` and
# `echo_r->h_right` stay dark.
#
# ── BISTABLE READOUT (the `facet` / ByAngle material, built in R4a) ──
# The spine's end wall (`wall_trace`) is skinned with `preset = facet` — the
# angle-driven super-glyph (`SuperSelector::ByAngle`) whose symbol CHANGES with
# the viewing azimuth. Skinning the readout surface with it makes the "name"
# glyph read differently as the camera turns: two records, one self. The
# bistable image is SEEN BY TURNING (live) — walk the arc around the spine's
# end in the court and the wall's hatch/letterform rotates between its two
# faces. A static --dump captures one face; the angle-dependence is a live,
# in-terminal beat.
#
# The both-true readout resolves `both`'s pool to a name that is NOT "Aleks" —
# a feminine readout the player takes for an error. It plants the L12 reveal
# ("the name is HERS"), solved not told.
#
# ── COLD SPIKE / atmosphere ──
# Cold blue fog, snow-static effect, a symmetric warm-tinted lamp pair (one
# cooler, one warmer — "two records") for mood. A battery dock-warning beat
# lives in the system_log note.
#
# Verify:
#   cargo run -p re_game --release -- --dump levels/L9-stereopsis.lvl --ansi
#   (re_lvlcheck::check_level → COHERENT / SOLVABLE)

[meta]
name        = level-09-stereopsis
title       = Stereopsis
version     = 1
spec_rev    = 2026-06-18
prop_style  = vault

[room]
size        = 22 15 6
ambient     = solid
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05). At most N pipes may be
# ON at the same time; switching one ON at the cap is REFUSED (the pipe stays off
# and nothing else changes), switching one OFF always frees a unit. Absent or 0 =
# unlimited, which is what every non-campaign level still carries.
# WHY: the forward pass has no inhibition, so activation is MONOTONE in the ON-set
# — without a cap, all-switches-ON wins whenever anything wins, and every decoy in
# the campaign is decorative. This is the number that makes wrong wiring cost.
# THIS LEVEL: 6 of 8 pipes (widened from 6 pipes 2026-09-23 (real-world): the two echo pipes
# are new). The real solve is still all six structural wires — both hidden
# nodes are T=2 and `both` is T=2, so every one of THOSE wires is load-bearing.
# The cap now genuinely binds: with 8 switchable pipes it is no longer possible
# to "flip everything" — spending a unit on either echo starves that echo's own
# hall below threshold, and the budget has no spare unit to make it up.
power_budget = 6
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# THE READOUT WALL — `facet` (ByAngle / R4a): an angle-driven glyph. Walk the
# court and the letterform rotates between its two faces — the bistable "name".
# Bound on wall_trace so the spine (and every pipe trace) carries it.
[material readout_facet]
preset      = facet
surface     = wall_trace

# BONE-AND-SILVER walls (2026-09-23 (real-world) redesign, breaking the D8 cyan run). `stone`
# is the Brick recipe with deep relief and deep AO — masonry, not circuitry.
[material hall_wall]
preset      = stone
fg          = #B8B4AC
bg          = #141210
surface     = wall_solid

# Dark steel floor (unchanged value from the pre-redesign file).
[material hall_floor]
fg          = #54606A
bg          = #060A0E
recipe      = grain scale=3.0 speck=0.10
surface     = floor

# Ceiling: plain dark grain — `frost` DROPPED (D8: P3/P4 had four consecutive
# frost ceilings; L8 keeps the one that survives).
[material hall_ceiling]
fg          = #2A3038
bg          = #04060A
recipe      = grain scale=3.0 speck=0.08
surface     = ceiling

# THE MIRRORS. Bind the matrix surface to a reflective material; the two
# `[wall_decal]`s below paint it onto just the two hall-end west-wall regions,
# so the rest of the perimeter stays plain `stone`. `clarity` here is the
# STARTING clarity; the campaign's `mirror_ramp` drives it live.
# `watch_wall` (watcher) is DROPPED here — this slot is spent on the mirrors.
[material end_mirror]
fg          = #C8D2FF
bg          = #05060A
surface     = wall_matrix
reflective  = true
clarity     = 0.6

[wall_decal mirror_left]
surface     = matrix
region      = (0,1,1)-(0,6,4)

[wall_decal mirror_right]
surface     = matrix
region      = (0,8,1)-(0,13,4)

# Cold blue fog — the dock-warning chill. Near/far tuned so the readout wall
# stays legible while the room breathes cold. fog_far LOCKED at 13.0.
[palette]
fog_color   = #0A1018
fog_near    = 3.0
fog_far     = 13.0

# Snow-static drift + a faint matrix shimmer: a cold, granular air.
[effects]
snow        = on
matrix      = 0.10

# Symmetric lamp pair — two records, slightly different tints (one cooler, one
# warmer) — over the middle of each hall.
[light]
pos         = 5.0, 3.5, 4.0
color       = #CFE4EC
radius      = 4.0
intensity   = 0.7

[light]
pos         = 5.0, 10.5, 4.0
color       = #ECD4DA
radius      = 4.0
intensity   = 0.7

[atmosphere]
ambient     = 0.12
postfx      = subtle    # P3 "The Basement & The River" — owner-approved 2026-09-23 (real-world) per-movement postfx

# ── [cells] — the spine wall + the two halls ──────────────────────────────────
# The spine (x=1..10, y=7, full height z=1..4) is WallTrace so it carries the
# `facet` readout. Every pipe cell this grid touches at z=2 is repainted `/`
# so `render_pipes`'s side_data (flow scroll, pool words, the switch/cycle
# pulse) survives `[cells]` being authoritative — node cells are left plain,
# matching `L1-first-pulse.lvl`'s convention. None of the eight pipes crosses
# the spine west of x=11 (the merge point), so the spine stays intact.
[cells]
size        = 22 15 6

