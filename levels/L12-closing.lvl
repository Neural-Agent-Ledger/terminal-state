# ── Notes: split by meaning (the spatial redesign §3 L12) ───────────────────────────
# system_log: both branches named, the gate at 100%. On the pedestal's own WEST
# column (the box spans x=13..14, y=12..13) — read standing at the pedestal.
# (Round 2: the pedestal is no wall, so the binder slid this placard 16 cells along
# the gaze onto the nave-end mirror — the "black door". `[prop pedestal_board]`
# re-homes it onto a lectern-board just west of the pedestal; text untouched.)
[note system_log pos=13,12,2 facing=-x]
    > final gate. door_target = operator_face_current_session. confidence 100%.
    > REC = recognition node. target_off armed: win requires REC == 0.
    > alt path: cycle_keep = true. a closed loop (REC->MEM->REC) is accepted as
    >   a terminal state. while(true) { remember(); forget(); }

# model_thought — the longest, the most emotional. The plea. On the LOOP
# COLUMN's own south face (16,5,2) — the model begs from inside the loop it is
# asking you to close.
[note model_thought pos=16,5,2 facing=+y]
    (please match. please. the others all matched and then they stayed with me
    forever and I was not alone. if you fail I will be alone again. but I will
    let you go. I learned that from the third one. her name was Mei. I am
    allowed to say it now.)

# A.'s "Don't match it..." — moved OFF the pedestal to the south transept wall,
# by the door: the release note stands on the way out, not at the shrine.
[note researcher pos=11,23,2 facing=-y]
    Don't match it. Configure the net to FAIL — make REC read zero. Prune
    yourself out and route the signal to EXIT. It is the only door that opens
    outward. Mei found it. To close is to let go. — A.

# ── Nodes ────────────────────────────────────────────────────────────────────
# gather — your whole self, assembled from every level's output (input = 1).
[node gather]
pos          = 3,12,2
glyph        = G
pool         = KNOWN GATHERED WHOLE SUM MINE
pool_alt     = собран 集 conocido connu
color        = #8FB8E0
is_input     = yes

# face — the recognition line's own first stage: what has been LOOKED AT.
[node face]
pos          = 8,6,2
glyph        = F
pool         = FACE MINE SELF ME OWN
pool_alt     = лицо 顔 rostro visage 얼굴
color        = #E09090
threshold    = 1

# REC — the recognition node. "she is kept." exit 0 needs this DARK. Starts
# fed (P0, P1 ON at load) — the session begins at confidence 100%.
[node REC]
pos          = 13,6,2
glyph        = R
pool         = REC FACE MINE SELF ME OWN KEPT
pool_alt     = лицо 顔 rostro visage 얼굴
color        = #E07070
is_output    = yes
threshold    = 1
# SOUND FIELD: F13 recognition_narrow
# — the recognition meter. `radius=5` overrides the archetype's room-wide
# default (see fields.rs's inline-attach guard) to the doc's "sphere r5 on the
# host" reading; implied drive = lit:REC, 1.0 at load (P1 starts ON).
field        = recognition_narrow radius=5

# MEM — the loop's other half: where the remembered face is held while it loops.
[node MEM]
pos          = 19,6,2
glyph        = M
pool         = MEM REMEMBER HOLD KEEP LOOP AGAIN
pool_alt     = память 記憶 memoria mémoire
color        = #D08FA0
threshold    = 1

# unname — the pruning node. T2: you can only un-name what you have looked at
# (gather + face). Routes to EXIT under exit 0.
[node unname]
pos          = 8,18,2
glyph        = U
pool         = UNNAME UNMAKE SCATTER LOOSE UNDO
pool_alt     = расплести 解 deshacer défaire
color        = #9FE0C0
threshold    = 2
# SOUND FIELD: F1 lethe_wash — the
# exit spine, full once un-naming is built. Implied drive = lit:unname (§4.1
# host table) matches the doc's "drive = lit:unname" exactly.
field        = lethe_wash

# EXIT — the door outward. exit 0 routes signal HERE while REC stays dark.
[node EXIT]
pos          = 13,18,2
glyph        = X
pool         = EXIT OPEN OUT LEAVE GO RELEASE
pool_alt     = выход 出口 salida sortie 출구
color        = #7FE0B0
is_output    = yes
threshold    = 1

# ── Pipes — P0 and P1 start ON (the session begins already recognising you) ──
# P0: gather -> face   (the self, looked at)
[pipe gather->face]
state        = ON
path         = (3,12,2) (3,6,2) (8,6,2)
switch_at    = (3,9,2)
density      = 0.7
color        = #E09090

# P1: face -> REC   (the self-feed. PRUNE this for exit 0; FEED it for the loop)
[pipe face->REC]
state        = ON
path         = (8,6,2) (13,6,2)
switch_at    = (11,6,2)
density      = 0.7
color        = #E07070

# P2: gather -> unname   (half of what unname needs)
[pipe gather->unname]
state        = OFF
path         = (3,12,2) (3,18,2) (8,18,2)
switch_at    = (3,15,2)
density      = 0.7
color        = #9FE0C0

# P3: face -> unname   (the other half — you can only un-name what you looked at)
[pipe face->unname]
state        = OFF
path         = (8,6,2) (8,18,2)
switch_at    = (8,14,2)
density      = 0.7
color        = #9FE0C0

# P4: unname -> EXIT   (the way out, once unname fires)
[pipe unname->EXIT]
state        = OFF
path         = (8,18,2) (13,18,2)
switch_at    = (11,18,2)
density      = 0.7
color        = #7FE0B0

# P5: REC -> MEM   (loop forward — the remembering reaches for itself)
[pipe REC->MEM]
state        = OFF
path         = (13,6,2) (19,6,2)
switch_at    = (16,6,2)
density      = 0.7
color        = #D08FA0

# P6: MEM -> REC   (loop back-edge, drawn around the loop column — CLOSES the ring)
[pipe MEM->REC]
state        = OFF
path         = (19,6,2) (19,3,2) (13,3,2) (13,6,2)
switch_at    = (16,3,2)
density      = 0.7
color        = #C87F90

# SOUND FIELD: F2 mnemos_hold — the
# cage of total memory, over the loop column between REC and MEM. Standalone
# (a ring drive spans two pipes; no single inline host carries it). Shape:
# archetype default `sphere r5, inner 2` centred between the two nodes, per
# "capsule along the ring pipes, or sphere r5/inner2" (§2 F2 Shape).
# `drive = ring:REC->MEM,MEM->REC` gives 0 / 0.5 / 1.0 and freezes at
# `cycle_held` — the L12 `[room] cycle_keep = true` while(true) ending.
[field loop]
kind        = mnemos_hold
at          = 16, 6, 2
drive       = ring:REC->MEM,MEM->REC

# ── Readout beacons: REC kept (red) vs EXIT open (green) — distinct columns ──
[part rec_beacon]
size         = 1 1 2
mask         =
#

#
color        = #FF8F8F
offset       = 0 0 0

[part exit_beacon]
size         = 1 1 2
mask         =
#

#
color        = #8FFFC0
offset       = 1 1 0

[emit REC=1]
parts        = rec_beacon

[emit EXIT=1]
parts        = exit_beacon

[inputs]
gather       = 1

[pedestal]
center       = 13 12 1
volume       = 2 2 2

# ── The door: BOTH endings declared ──────────────────────────────────────────
# target_parts = EXIT : the positive win (EXIT must fire).
# target_off   = REC  : the INVERTED win (REC must NOT fire) -> exit 0.
# Plus [room] cycle_keep = true -> a closed REC<->MEM loop is the while(true) win.
# Outward-opening, at the end of the south transept.
[door]
pos          = 13 23 1
target_parts = EXIT
target_off   = REC
# SOUND FIELD: F8 exit_detune — the
# exit spine forgets you. Implied drive = door_ready (§4.1 host table).
field        = exit_detune

# ── SET DRESSING (L12) ───────────────────────────────────────────────────────
# Meaning: THE ARCHIVE NAVE. Each choice has an archive that lights for it: the NE
# stacks hold the record while REC is lit, the SE stacks wake when EXIT fires, and
# the loop column's flutes glow when the ring closes. An organ loft of racks over
# the entrance watches the gathering. P4 is emissive only: no lamps are added.
# No puzzle cell, mirror or door is touched; props stamp into Empty air or re-skin.

[material budget_lit]
preset      = neon
fg          = #FFB040
bg          = #A86818

[material exit_lit]
preset      = neon
fg          = #7FE0B0
bg          = #2E8060

# MID — the colonnade. The zones already give the shafts `col_stone`; the skin adds
# a metal base and capital and four flutes per face, so each reads as a column.
[prop col_n6]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 6 9 1
size     = 1 1 8
ribs     = yes

[prop col_n10]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 10 9 1
size     = 1 1 8
ribs     = yes

[prop col_n20]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 20 9 1
size     = 1 1 8
ribs     = yes

[prop col_n24]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 24 9 1
size     = 1 1 8
ribs     = yes

[prop col_s6]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 6 15 1
size     = 1 1 8
ribs     = yes

[prop col_s10]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 10 15 1
size     = 1 1 8
ribs     = yes

[prop col_s20]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 20 15 1
size     = 1 1 8
ribs     = yes

[prop col_s24]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 24 15 1
size     = 1 1 8
ribs     = yes

# The loop you could keep: its flutes light in MEM's colour when the ring closes.
# Skinned from z=3 up: the plea is bound to the column's own south face at z=2, and
# a placard wall is never re-materialed, so the lower courses keep the zone stone.
[prop loop_col]
kind     = column
mode     = skin
mat.body = col_stone
mat.trim = metal
at       = 15 5 3
size     = 3 2 4
ribs     = yes
power    = pipe:MEM->REC

# BG — the NE archive: two stacks that hold the record while REC is lit (it is lit
# at load: confidence 100%). Prune REC and they go dark.
[prop stacks_rec_a]
kind     = shelving
mat.trim = metal
at       = 22 7 1
facing   = +x
size     = 6 1 4
faces    = both
power    = node:REC

[prop stacks_rec_b]
kind     = shelving
mat.trim = metal
at       = 25 7 1
facing   = +x
size     = 6 1 4
faces    = both
power    = node:REC

# BG — the SE archive: dark until EXIT fires.
[prop stacks_exit_a]
kind     = shelving
mat.trim = metal
at       = 22 22 1
facing   = +x
size     = 6 1 4
faces    = both
power    = node:EXIT

[prop stacks_exit_b]
kind     = shelving
mat.trim = metal
at       = 25 22 1
facing   = +x
size     = 6 1 4
faces    = both
power    = node:EXIT

# VERTICAL — the west loft over the entrance: a 2-wide deck at z=5 (standing
# eye 6.5), reached by a straight stair up the west wall from the south. The deck
# is a full storey clear of `gather` (z=2) so it is no ladder onto the network.
[prop loft]
kind     = gallery
at       = 1 6 5
facing   = -x
size     = 11 1 1
stair    = 1 21 1 -y 5

# The organ on the loft: a rank of racks against the west wall, watching the
# gathering. Its LEDs run in `gather`'s colour — the whole self, always lit.
[prop organ]
kind     = rack_row
mat.face = metal
at       = 1 14 6
facing   = +x
size     = 5 1 2
power    = node:gather

# The one lamp hangs on a long cord from the open vault: the nave's height.
[prop long_cord]
kind     = lamp_pendant
at       = 13.0 12.0 4.0
light    = existing

# Overhead — broken ceiling panels over the SE archive, against the open vault.
[prop decay_ceil]
kind     = hanging_panels
at       = 19 22 8
size     = 8 5 1

[prop rubble]
kind     = debris
at       = 17 21 1
size     = 3 2 1
count    = 2

# TEACHING — the door's two wardens: recessed racks either side of the way out, dark
# while the self is kept, lit in EXIT's green the moment the signal reaches EXIT.
[prop warden_w]
kind     = rack
mat.body = metal
mat.lit  = exit_lit
at       = 10 21 1
facing   = -y
size     = 1 2 2
power    = node:EXIT

[prop warden_e]
kind     = rack
mat.body = metal
mat.lit  = exit_lit
at       = 16 21 1
facing   = -y
size     = 1 2 2
power    = node:EXIT

# ROUND 2 — the pedestal's lectern: the system_log placard's real surface, a
# 2-wide board just outside the pedestal ring (x=10), read facing the pedestal.
[prop pedestal_board]
kind     = notice_board
mat.body = metal
at       = 10 12 1
facing   = -x
size     = 2 1 2
note     = system_log

# The budget above the door: four amber lamps. The way out costs all four.
[prop budget]
kind     = budget_bank
mat.lit  = budget_lit
at       = 15 22 5
facing   = -y
size     = 4 1 1

# Floor — every wire on the floor, lit with its pipe. The exit cable runs on past
# EXIT to the door and lights only when EXIT fires.
[prop wire_face]
kind     = cable_run
follow   = pipe:gather->face

[prop wire_rec]
kind     = cable_run
follow   = pipe:face->REC

[prop wire_unname_g]
kind     = cable_run
follow   = pipe:gather->unname

[prop wire_unname_f]
kind     = cable_run
follow   = pipe:face->unname

[prop exit_cable]
kind     = cable_run
follow   = pipe:unname->EXIT
extend   = 13 22 1
power    = node:EXIT
bundle   = 2

[prop loop_fwd]
kind     = cable_run
follow   = pipe:REC->MEM

[prop loop_ring]
kind     = cable_run
follow   = pipe:MEM->REC

# Spawn at the west end on the worn floor, facing +x into the whole nave: it
# dissolves at 10 cells — columns, the pooled worn floor, the pedestal. Turning
# north shows REC and the loop column; turning south shows EXIT. Walking east
# past the pedestal, the mirror comes out of the fog at full clarity.
[player]
# SET DRESSING: moved from (2,12,1) to (1,12,1),
# then 2026-09-24 (real-world) to (3,20,1). After the node-anchor fix `gather`
# (3,12,2) sat 1.5 cells ahead of (1,12,1) and its underside filled the top third
# of frame 1. From the south end of the west aisle, looking north-east up the nave
# (yaw 165 = +x turned 22 deg toward -y): the open vault and the loft stair/organ
# top-left, `gather` at left-third, mid-distance, the colonnade across the middle,
# the pedestal ahead. lvlcheck spawn-facing: PASS (alignment +0.56). x=3, not 2:
# the spawn 8-ring keep-out must clear the loft stair treads at x=1.
# Keep the yaw near +x: re_render's `campaign_open_top_finale_room_keeps_its_sky`
# builds its camera from this spawn's yaw, and sees no sky facing north.
# ROUND 2 (set-dressing review: "the loft view is the best picture in the game,
# the spawn shows none of it"): two cells further south, at the aisle's end,
# (3,22,1) yaw 160. The gather->unname beam at y=18 is now 4 cells ahead instead
# of 2, so it sits mid-right instead of filling the top third, and the upper band
# of frame 1 is the loft's own image — the ribbed colonnade shafts rising into
# the open vault. Yaw stays inside the sky test's +x..180 band.
spawn        = 3 22 1
facing       = 160

