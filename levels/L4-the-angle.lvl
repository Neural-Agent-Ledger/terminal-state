# TERMINAL STATE — levels/L4-the-angle.lvl
#
# L4 · "The Angle" — REBUILT to the 2026-09-23 (real-world) owner-approved spatial redesign
# (the spatial redesign §3 L4) + the final puzzle graph
# (the puzzle-graph redesign §L4). The room is now a long, tall,
# colonnaded calibration RANGE instead of a plain 20x14 box, and the graph is
# rebuilt so that BOTH stacked lines are load-bearing (see below).
#
# CAMPAIGN SLOT: manifest #4 · movement P2 "THE CALIBRATION WING"
#                load ▅ (the first real demand)
# IDENTITY: a long, tall calibration range with a colonnade. Two lines stacked
# in the air read as one down the axis and split the moment you step into a
# bay, and one bay holds a mirror that shows the range without you.
#
# ── MECHANIC (pure data — geometry + a free camera; no engine feature) ────────
#   is_round   (IN=1, z=2, on-axis)   ──┐
#   is_pointed (IN=1, z=2, off-axis)  ──┼─► tapered (T=2) ─► output ─► door
#   has_loop   (IN=0, z=4, stacked over is_round) ──┘ (feeds tapered too, but held at 0)
#
# THE LOCK. `is_round` and `has_loop` share the SAME corridor centreline (y=5)
# and run parallel along x, STACKED in z (live at z=2, dead at z=4). Looked at
# straight down the corridor from the spawn camera they project onto the same
# screen COLUMN and read as ONE line — you cannot tell which of the two
# sources actually feeds the junction. STRAFE, and parallax splits the single
# apparent line into two distinct runs at two heights; only then does colour
# tell you which is alive.
#
# 2026-09-23 (real-world) GRAPH FIX (the puzzle-graph redesign §L4, owner-approved).
# The shipped graph let `is_pointed` alone solve the level (`tapered` T=1), so
# the stacked pair never had to be resolved — parallax was legible but
# OPTIONAL. `tapered` is now T=2: BOTH `is_round` AND `is_pointed` must fire,
# so the player must (a) find the live line among the stacked pair via
# parallax, AND (b) wire the watcher's off-axis line too. `has_loop` stays a
# free, harmless decoy — its pipe toggles and does nothing, its source held at
# 0. `power_budget` 2→3 (three switches ON: the two live feeds + the home
# stretch).
#
# SOLUTION (3 toggles): is_round->tapered, is_pointed->tapered, tapered->output.
#   `has_loop->tapered` toggles freely and does nothing — its source is held at 0.
#   Its pool reserve is NOOSE. The loop is not needed here. Not yet.
#
# READOUT (WORD_STORY §RESULT, canon): CURVE + TIP -> TEARDROP -> SHAPE
# NAME SHARD 4: the boundary token `://` — "where one thing stops being another".
#
# ── AUTHORING NOTE: pools vs. the "I AM SEEN" reading ─────────────────────────
# PUZZLE_CONCEPTS #1 describes the two pipes as carrying words that read `I AM SEEN`
# head-on and split into `I AM` / `SEEN BY` off-axis. WORD_STORY §2 is the pool
# dictionary of record for L4 and gives CURVE / TIP / LOOP / TEARDROP / SHAPE, and
# WORD_STORY §RESULT pins the L4 readout phrase to those anchors. Pipe words come
# from the source node's `pool` (W1 1.2) — there is no per-pipe word list — so
# honouring BOTH would mean overwriting the canon readout. Resolution: the POOLS are
# verbatim WORD_STORY, and the `I AM` / `SEEN BY` reading is carried by the placards
# and by the geometry that performs the split. Recorded, not silently substituted.
#
# ── TOKEN DISCIPLINE (W1 allowlist) ───────────────────────────────────────────
# No `{token}` appears in this file. FORM 22 carries none.
#
# ── SPACE (the spatial redesign §3 L4) ──────────────────────────────────────────────
# 22x11x7 corridor, centreline y=5, walk z=1..5. A colonnade of 6 full-height
# pillars (x=9,13,17 at y=2 and y=8) frames a narrow north bay (y=1), a wide
# nave (y=3..7) and a south bay (y=9). The south bay's far wall (y=10, x=12..14)
# carries a NOISY MIRROR (`range_mirror`, campaign `mirror_ramp` drives its live
# clarity — 3 name-shards -> ~0.36 at this point in the campaign): the one
# place you step aside to find "I AM" shows the range and not you. Four floor
# stripes (x=5,9,13,17) turn depth into a readable scale for the parallax read.
# `[room] ambient = solid` (D1 fix): the cyan `shell` wall material now
# actually paints the perimeter and pillars, `reflective = false` so the cold
# masonry stays masonry — only the decal'd mirror patch reflects.
#
# Verify:
#   cargo run -q -p re_game -- --dump levels/L4-the-angle.lvl --ansi
#   cargo run -q -p re_lvlcheck --bin lvlcheck -- levels/L4-the-angle.lvl

[meta]
name        = level-L4-the-angle
title       = The Angle
version     = 2
spec_rev    = 2026-09-23
prop_style  = range

[room]
size        = 22 11 7
ambient     = solid
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05; raised 2026-09-23 per
# the puzzle-graph redesign §L4). At most N pipes may be ON at the
# same time; switching one ON at the cap is REFUSED (the pipe stays off and
# nothing else changes), switching one OFF always frees a unit.
# WHY 3, NOT 2: `tapered` is now threshold 2 — BOTH `is_round` and `is_pointed`
# must feed it, plus `tapered->output` to carry the pulse home. That is the
# true minimum (3 of 4 pipes); `has_loop->tapered` is the one spare, harmless
# to try, and always dark.
power_budget = 3
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# ── ESCALATION (manifest fog_far = 17.0) ──────────────────────────────────────
# **The corruption ramp starts here**: `matrix = 0.10`, the first bleed. `steam = on`
# is the WARM axis (STORY_BIBLE §7: steam = a lab that still runs, snow = cold /
# forgetting) — PROGRESSION §2 L4(e) "warm steam returns faintly; the lab still runs
# through the fog." fog_far holds at L3's 17.0: the room does not close further, it
# just stops being clean. `glitch` stays 0 — pipes must stream the CLEAN pool here,
# because reading the words is how the parallax split is confirmed.
[effects]
matrix      = 0.10
steam       = on

[palette]
fog_color   = #0E1220
# fog_near pushed out 2.5 -> 5.0 (the spatial redesign §3 L4 materials note): the
# corridor's readable line span is 8-14 cells, and 2.5 fogged the near stripes
# before parallax could read them.
fog_near    = 5.0
fog_far     = 17.0

# ── COLOR-FORWARD palette ─────────────────────────────────────────────────────
# A long, cold, colonnaded range. Cold cyan masonry so DEPTH reads crisply
# (depth is the puzzle), the live wires hot amber / watcher pink, the dead
# wire a cold grey-blue. Colour is the confirmation once parallax has done the
# separating. `reflective = false` fixes invariant 7 (the spatial redesign §0.2 #7):
# the range's cold masonry must stay masonry — only the mirror decal reflects.
[material shell]
fg          = #58C0DC
bg          = #050A12
recipe      = circuit scale=1.6
reflective  = false
surface     = wall_solid

[material deck]
fg          = #66748A
bg          = #08101A
recipe      = grain scale=3.0 speck=0.15
surface     = floor

[material roof]
preset      = metal
fg          = #2A3442
bg          = #04060A
surface     = ceiling

[material live_trace]
preset      = monitor
fg          = #FFC24A
bg          = #100A06
surface     = wall_trace

# THE NOISY MIRROR (the spatial redesign §2 motif 2, §3 L4, §6 risk 3/8). Bound to
# the `wall_matrix` surface slot; the `[wall_decal]` below re-kinds the south
# bay's far wall patch to `matrix` so only that patch shows it. Authored
# `clarity = 0.5` is the file's own static default — the campaign's
# `re_game::mirror_ramp` drives the LIVE clarity from shard progress while a
# campaign level is loaded (L4 is early: ~3 shards -> clarity ~0.36, a mostly
# noisy reflection).
[material range_mirror]
fg          = #C8D2FF
bg          = #05060A
reflective  = true
clarity     = 0.5
surface     = wall_matrix

[wall_decal]
surface     = matrix
region      = (12,10,1)-(14,10,3)

# Range stripes — floor-only zones that turn the corridor's depth into a
# readable scale (the parallax split depends on depth being legible).
[material range_stripe]
fg          = #C8D8E8
bg          = #08111E
recipe      = brick aspect=1.0 mortar_w=0.12 grain=0.20

[zone stripe_x5]
region      = (5,1,0)-(5,9,0)
material    = range_stripe
scale       = none

[zone stripe_x9]
region      = (9,1,0)-(9,9,0)
material    = range_stripe
scale       = none

[zone stripe_x13]
region      = (13,1,0)-(13,9,0)
material    = range_stripe
scale       = none

[zone stripe_x17]
region      = (17,1,0)-(17,9,0)
material    = range_stripe
scale       = none

# Hard raking key light down the axis (from behind the player, toward the far
# wall), plus one warm lamp over the private (is_round) line only.
[atmosphere]
key_dir     = 0.9, 0.0, 0.4
key_color   = #B8D8F0
ambient     = 0.20

[light]
pos         = 13.0, 5.0, 3.2
color       = #FFC24A
radius      = 2.5
intensity   = 0.8

# ── Dense [cells] grid — the colonnade + the door notch ──────────────────────
# 22 cols (x=0..21) x 11 rows (y=0..10) x 7 z-layers.
# Pillars: full-height (z=1..5) at (9,2) (13,2) (17,2) (9,8) (13,8) (17,8).
# Painted '/' cells are the pipe network at its z-layer (WallTrace air, above
# the walking layer z=1, so collision — which probes floor(eye_z)=1 — never
# sees them; the L1-first-pulse.lvl precedent for this technique). Node cells
# themselves are left as plain air '.'; only the connecting runs are painted.
# The door notch at (21,5) is carved open at z=1..3 (walk height) since
# `[cells]` is authoritative and does not auto-open a doorway the way a plain
# `[room] size` box does.
[cells]
size        = 22 11 7

# z=0 — floor slab.
