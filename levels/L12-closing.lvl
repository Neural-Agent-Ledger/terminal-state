# TERMINAL STATE — levels/L12-closing.lvl
#
# L12 · "The Closing" — REBUILT to the 2026-09-23 (real-world) owner-approved redesign
# (the spatial redesign §3 L12 + the puzzle-graph redesign
# L12). THE BIFURCATED FINALE. The campaign ends here, and the ending is chosen
# by your FINAL wiring. There is no third path; the choice IS the ending, and it
# is permanently ambiguous.
#
# ── SPACE (NEW) — the archive nave ───────────────────────────────────────────────
# 30x24x10 — larger than the fog (fog_far 10). A basilica: the nave axis runs
# west-east along y=12. Colonnades stand at y=9 and y=15, x in {6,10,20,24}. The
# north apse (REC/MEM) is around a LOOP COLUMN at (15..17, 4..5) — the ring pipe
# is drawn AROUND it, so the museum of wounds is a thing you walk around. The
# south transept runs toward EXIT and the outward-opening door. At the east end,
# past the pedestal, a MIRROR at full clarity shows the nave, the columns and the
# pedestal — with nobody standing on the worn floor.
#
# ════════════════════════════════════════════════════════════════════════════
# TWO ENDINGS — both built by your last toggle (re_puzzle additive win features)
# ════════════════════════════════════════════════════════════════════════════
#
# Ending 1 — `exit 0`  (LETHE releases · INVERTED target, feat: target_off)
#   WIN when REC does NOT fire (confidence <= threshold) while EXIT does.
#   You PRUNE your own self-feed so REC stays dark, and route signal to EXIT —
#   "the only door that opens outward. Prune yourself out. Mei found it." — A.
#   Mechanic: [door] target_parts = EXIT + target_off = REC.
#
# Ending 2 — `while(true)`  (MNEMOS keeps · CYCLE-KEEP, feat: cycle_keep)
#   WIN by deliberately wiring a LOOP: REC -> MEM -> REC, closed around the loop
#   column. [room] cycle_keep = true lets the loop STAND as a valid terminal
#   state — "remember(); forget();", the museum of wounds.
#
# ── REBUILT GRAPH (the puzzle-graph redesign L12 §1-2) ──────────────
# The SHIPPED graph had a defect: `exit 0` was a SINGLE toggle from an all-dark
# start (REC was already dark, so "prune yourself out" was never actually
# PERFORMED). Rebuilt with the CONTENT_PACK L12 nodes `face` and `unname`, which
# neither prior source had wired:
#
#   The level now STARTS with recognition ON: gather->face->REC are authored ON
#   at load (REC = 1, the beacon red — "confidence 100%", matching the system
#   log). `exit 0` now means building `unname` (T2 = gather + face: you can only
#   un-name what you have looked at) and routing it to EXIT, THEN PRUNING
#   face->REC — the only productive unit to give back under budget 4.
#   `while(true)` closes the ring: two toggles, the cheap ending. Keeping is
#   easy; letting go costs.
#
#   gather (input=1)
#     ├─[P0 gather->face, ON]──► face (T1) ─[P1 face->REC, ON]──► REC (T1, target_off)
#     │                            │                                  ▲
#     │                            └─[P3 face->unname]──► unname (T2) │
#     └─[P2 gather->unname]────────────────────────────────┘   [P4]──► EXIT (T1, target)
#                                                          REC ─[P5]──► MEM (T1) ─[P6]──► REC
#
# Seven switchable pipes; P0 and P1 start ON, the rest OFF:
#   P0 gather->face (ON)  P1 face->REC (ON)  P2 gather->unname  P3 face->unname
#   P4 unname->EXIT        P5 REC->MEM        P6 MEM->REC
#
# power_budget = 4 (was 3). At load, draw = 2 (P0, P1).
#
# ── HOW EACH ENDING IS WIRED (from the load state, draw 2/4) ─────────────────────
#   exit 0      : -P1, +P2, +P3, +P4 (draw 4/4). face=1, REC=0 (P1 off, P6 off),
#                 unname = gather+face = 2 >= 2, EXIT=1. No ring -> acyclic.
#                 target_parts met + target_off met. WIN. This is the ONLY
#                 exit-0 configuration (EXIT needs unname; unname needs P2, P3
#                 and face via P0; so P0,P2,P3,P4 ON = 4 units, P1 OFF).
#   while(true) : +P5, +P6 (draw 4/4, P0/P1 may stay or go — the held cycle
#                 does not need a feed). The ring REC->MEM->REC closes under
#                 cycle_keep; Kahn stalls, the ring latches, cycle_held is set.
# Exclusivity: exit 0 needs 4 units with P5,P6 OFF; the ring needs 2 more on top
# of whatever else is on. 6 > 4, so no reachable state satisfies both.
#
# ── re_lvlcheck NOTE (ISSUES) ────────────────────────────────────────────────────
# This is an INVERTED + CYCLE-KEEP level with a non-all-OFF LOAD state.
# solve_brute_force respects both modes and reports the minimal winning toggle
# DELTA from the authored start — the exit-0 branch (4 toggles: -P1,+P2,+P3,+P4)
# and the while(true) branch (+P5,+P6, 2 toggles) are both covered explicitly by
# re_puzzle unit tests.
#
# ── MOOD: the archive — emissive only, larger than the fog ───────────────────────
# Void walls (the dark we booted from), stone columns, a watcher lattice on the
# north apse wall, a decay wall on the south transept, a WORN_FLOOR zone at the
# pedestal (many Alekses stood there), a redacted ceiling (the names taken,
# struck out overhead), and one cold lamp over the worn floor. Fog returns
# almost to black — session 0001's void, reached at the end.
#
# Verify:
#   cargo run -p re_game --release -- --dump levels/L12-closing.lvl --ansi
#   (re_lvlcheck::check_level -> COHERENT / SOLVABLE — see ISSUES note above)

[meta]
name        = level-12-closing
title       = The Closing
version     = 2
spec_rev    = 2026-09-23
prop_style  = archive

# The archive nave — larger than the fog. cycle_keep arms the while(true) ending.
[room]
size        = 30 24 10
ambient     = solid
cycle_keep  = true
# POWER BUDGET (v0.2 re-scope, user-approved 2026-08-05; RAISED 2026-09-23 per
# the puzzle-graph redesign L12). THIS LEVEL: 4 of 7 pipes. The
# while(true) ending is now the cheaper one (2 toggles from load); exit 0 needs
# the full 4 — building unname AND pruning the self-feed. The cap still forbids
# all-seven-on, so the finale cannot be brute-forced by flipping everything.
power_budget = 4
# Draw the puzzle NETWORK. Without this the pipes the player actually manipulates
# are invisible wiring: no flow scroll, no powered-hue lift, no streaming node
# word-pool, and no switch-toggle / cycle-reject event pulse has a surface to
# appear on. Traces stamp into EMPTY air only, so no geometry is clobbered.
render_pipes = true

# ── Surfaces: the archive, void and stone, fog returning to session 0001 ─────────
# VOID structural walls — the near-black we cold-started from in L1. D1 FIX:
# ambient = solid so this actually paints the perimeter.
[material void_wall]
preset      = void
surface     = wall_solid

# The colonnade + loop column material — bound via [zone] (columns are WallSolid
# cells that would otherwise inherit `void_wall`; stone gives them a distinct,
# lit-relief presence against the void).
[material col_stone]
preset      = stone

# The WATCHER lattice — a world-fixed eye/face that has looked the whole time.
# Re-kinded onto the north apse wall via [wall_decal] below.
[material watch_wall]
preset      = watcher
surface     = wall_trace

# THE MIRROR — the east wall, past the pedestal. `re_game::mirror_ramp` overrides
# live clarity on campaign levels (L12's nave mirror reaches full clarity, the
# only fully-crisp mirror in the campaign); `clarity` here is the authored base.
[material mirror_wall]
fg          = #C8D2FF
bg          = #05060A
reflective  = true
clarity     = 0.85
surface     = wall_matrix

# The DECAY wall — bit-rot at the edges: the record of every Aleks is rotting.
# Bound via [zone] to the south transept wall (the wall_matrix slot is spoken
# for by the mirror).
[material decay_wall]
preset      = decay

# Base nave floor — near-black grain.
[material nave_floor]
fg          = #232A34
bg          = #020304
recipe      = grain scale=3.4 speck=0.10
surface     = floor

# WORN_FLOOR — scuffed grooves + settled dust, now a [zone] concentrated around
# the pedestal only (many Alekses stood exactly there, a long, long time).
[material worn]
preset      = worn_floor

# A cold, redacted ceiling — the names taken, struck out overhead.
[material struck_roof]
preset      = redacted
surface     = ceiling

# The colonnade columns (both rows) and the loop column — stone, distinct from
# the void perimeter. Zones are SOLID-ONLY, so the open floor between columns
# is untouched; only the column cells themselves pick up the material.
[zone colonnade_north]
region      = (5,9,1)-(25,9,8)
material    = col_stone
scale       = none

[zone colonnade_south]
region      = (5,15,1)-(25,15,8)
material    = col_stone
scale       = none

[zone loop_column]
region      = (15,4,1)-(17,5,6)
material    = col_stone
scale       = none

# The worn floor, concentrated at the pedestal.
[zone worn_pedestal]
region      = (10,9,0)-(16,15,0)
material    = worn
scale       = none

# The watcher lattice, across the north apse wall.
[wall_decal watcher_apse]
surface     = trace
region      = (10,0,1)-(20,0,5)

# The mirror, at full width on the east wall past the pedestal.
# ROUND 2: this decal never showed — `[cells]` is stamped after the shell and
# re-kinds x=29 back to WallSolid, so the "mirror" rendered as the void wall with
# a misplaced placard on it (critic: "a blank dark wall with a black door"). The
# same cells are now authored `%` (WallMatrix) in the `[cells]` grid below, so the
# mirror_wall material actually binds; the decal stays as the record of intent.
[wall_decal mirror_east]
surface     = matrix
region      = (29,8,1)-(29,16,6)

# Decay on the south transept wall, by the way out. Left in two bands flanking
# the door (x=11..15 stays clear) so the release note has an unclaimed,
# untagged wall cell to bind to right beside the threshold.
[zone decay_transept_w]
region      = (5,23,1)-(9,23,4)
material    = decay_wall
scale       = none

[zone decay_transept_e]
region      = (17,23,1)-(20,23,4)
material    = decay_wall
scale       = none

# ── Near-black fog (return to L1's void) ─────────────────────────────────────
[palette]
fog_color   = #02030A
fog_near    = 1.5
fog_far     = 10.0

# The only lamp in the room — cold, over the worn floor.
[light]
pos         = 13.0, 12.0, 4.0
color       = #8090B0
radius      = 3.0
intensity   = 0.8

[atmosphere]
ambient     = 0.05
fog_height  = 0.3 0.25
postfx      = crt          # P4 THE ARCHIVE movement postfx, owner-approved 2026-09-23 (real-world)

[effects]
matrix      = 0.18
snow        = off

# The archive's slow, patient breath — a cold drift rising in the dark.
[emitter archive_breath]
origin_world    = 13.0 9.0 1.0
colors          = 0x223044 0x101826 0x04060E
color_mode      = RampOverAge
family          = growth_dot
bold            = ByAge
direction       = 0.0 0.0 1.0
spread_deg      = 38.0
size            = 0.95
growth          = 1.05
rate            = 8.0
speed           = 0.34
speed_spread    = 0.14
path_jitter     = 0.07
lifetime        = 3.8
lifetime_spread = 0.6
accel           = 0.0 0.0 0.07
max_particles   = 200
seed            = 1207

# ── Dense [cells] grid ────────────────────────────────────────────────────────
# 30 cols (x=0..29) x 24 rows (y=0..23) x 10 z-layers (z=0..9). z=0 floor slab;
# z=1..9 walking / node-pipe / service / upper wall courses. Colonnade columns
# at x in {6,10,20,24}, y in {9,15}, full height z=1..8. The loop column at
# x=15..17, y=4..5, z=1..6 (shorter — a monolith, not touching the ceiling).
#
# Pipe cells at z=2 are painted WallTrace along the FULL expanded path (z=2 is
# strictly overhead of the z=1 walking layer collision checks) — the P5/P6 ring
# is drawn AROUND the loop column, never crossing it.
[cells]
size        = 30 24 10

